---
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import Media from '../../components/Media.astro';
import { projects, disciplines, projectCode, type Project } from '../../data/projects';
import { getCaseStudy, type Block } from '../../data/case-studies';

export function getStaticPaths() {
	return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const study = getCaseStudy(project.slug);
const i = projects.indexOf(project);
const next = projects[(i + 1) % projects.length];

type Laid = Block & { kind?: string; layout?: string };
let blocks: Laid[] = (study?.blocks ?? []) as Laid[];
// Credits (course, team, role) at the top move into the header under the facts
const credits: Laid[] = [];
while (blocks[0]?.type === 'text' && blocks[0].kind === 'credits') credits.push(blocks.shift()!);
// The opening paragraph or statement becomes the lead next to the title, magazine style
let lead: string | null = null;
const first = blocks[0];
const firstText = first?.type === 'text' ? first.html.replace(/<[^>]+>/g, ' ').trim() : '';
if (first?.type === 'text' && first.kind !== 'section' && (/<p>/.test(first.html) || firstText.length >= 40)) {
	lead = first.html;
	blocks = blocks.slice(1);
}
// Don't repeat the hero if the page opens with that same image
const dup = blocks.findIndex((b, i) => i < 3 && 'src' in b && study?.hero && b.src === study.hero.src);
if (dup >= 0) blocks = [...blocks.slice(0, dup), ...blocks.slice(dup + 1)];
const showHero = !!study?.hero;
const hasBody = study && !study.locked && blocks.length > 0;
---

<Base title={project.title} description={`${project.title} — ${project.summary}`}>
	<article>
		<header class="head">
			<div class="head-l">
				<p class="code">{projectCode(project)}</p>
				<h1>{project.title}</h1>
				<dl class="facts">
					<div><dt>Year</dt><dd>{project.year}</dd></div>
					<div><dt>Discipline</dt><dd>{disciplines[project.discipline]}</dd></div>
					<div><dt>Type</dt><dd>{project.summary}</dd></div>
					{project.context && <div><dt>With</dt><dd>{project.context}</dd></div>}
				</dl>
				{credits.map((c) => <div class="credits" set:html={c.html} />)}
			</div>
			{lead && <div class="head-r lead" set:html={lead} />}
		</header>

		{
			showHero && study?.hero && (
				<div class="hero">
					<Media block={study.hero} alt={project.title} sizes="100vw" eager />
				</div>
			)
		}

		{
			hasBody ? (
				<div class="body">
					<Blocks blocks={blocks} title={project.title} />
				</div>
			) : (
				<div class="notice">
					<p>{study?.locked ? 'Details of this project are available on request.' : 'Case study coming soon.'}</p>
					<a href="mailto:this.kaizhang@gmail.com">Get in touch →</a>
				</div>
			)
		}
	</article>

	<a class="next" href={`/work/${next.slug}/`}>
		<span class="label">Next</span>
		<span>{next.title} →</span>
	</a>
</Base>

<style>
	.head {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(12px, 1.6vw, 24px);
		row-gap: 32px;
		align-items: end;
		padding-top: clamp(40px, 8vh, 96px);
		margin-bottom: clamp(32px, 5vw, 64px);
	}
	.head-l {
		grid-column: 1 / 6;
	}
	.head-r {
		grid-column: 7 / 13;
	}
	.code {
		font: 12px var(--mono);
		letter-spacing: 0.04em;
		color: var(--muted);
		margin: 0 0 16px;
	}
	h1 {
		font-size: clamp(32px, 4.4vw, 60px);
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.025em;
		margin: 0 0 28px;
		text-wrap: balance;
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
		gap: 12px 16px;
		margin: 0;
		padding-top: 14px;
		border-top: 1px solid var(--line);
		font-size: 13px;
	}
	dt {
		font: 10px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		margin-bottom: 4px;
	}
	dd {
		margin: 0;
	}
	.credits {
		margin-top: 16px;
		font: 13px/1.6 var(--text);
		color: var(--muted);
	}
	.credits :global(p),
	.credits :global(h3) {
		font: inherit;
		margin: 0;
	}
	.lead :global(p) {
		font-family: var(--text);
		font-size: clamp(17px, 1.5vw, 21px);
		line-height: 1.45;
		font-weight: 400;
		margin: 0 0 0.8em;
		text-wrap: pretty;
	}
	.lead :global(p:last-child) {
		margin-bottom: 0;
	}
	.lead :global(h2),
	.lead :global(h3) {
		font-size: clamp(22px, 2.2vw, 32px);
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 0.6em;
	}
	.lead :global(h2 strong) {
		font-weight: inherit;
	}
	.hero {
		margin-bottom: clamp(48px, 7vw, 120px);
	}
	.body {
		padding-bottom: clamp(24px, 4vw, 64px);
	}
	.notice {
		padding: 48px 0;
		color: var(--muted);
	}
	.notice a {
		color: var(--accent);
	}
	.next {
		display: flex;
		justify-content: space-between;
		margin-top: 96px;
		padding-block: 24px;
		border-top: 1px solid var(--line);
		font-size: 20px;
		font-weight: 600;
	}
	.next .label {
		font: 12px var(--mono);
		color: var(--muted);
		align-self: center;
	}
	.next:hover {
		color: var(--accent);
	}
	@media (max-width: 800px) {
		.head-l,
		.head-r {
			grid-column: 1 / -1;
		}
	}
</style>
