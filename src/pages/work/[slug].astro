---
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Blocks from '../../components/Blocks.astro';
import Media from '../../components/Media.astro';
import { projects, archive, allProjects, projectCode, type Project } from '../../data/projects';
import { getCaseStudy, workImage, type Block } from '../../data/case-studies';

export function getStaticPaths() {
	return allProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props as { project: Project };
const study = getCaseStudy(project.slug);
const group = project.archive ? archive : projects;
const i = group.indexOf(project);
const next = group[(i + 1) % group.length];
const nextStudy = getCaseStudy(next.slug);
const nextCover = nextStudy?.cover ?? nextStudy?.hero;
const nextImg = nextCover && nextCover.type === 'image' ? workImage(nextCover.src) : null;

type Laid = Block & { kind?: string; layout?: string };
let blocks: Laid[] = (study?.blocks ?? []) as Laid[];

// ---- Credits (course, instructor, team, role…) become structured facts in the header ----
const KEYS: [RegExp, string][] = [
	[/^course$/i, 'Course'],
	[/^instructors?$/i, 'Instructor'],
	[/^(project )?duration$/i, 'Duration'],
	[/^(team( members?)?|project team)$/i, 'Team'],
	[/^(my )?role$/i, 'Role'],
	[/^(spe(?:a)?cial )?thanks$/i, 'Thanks'],
	[/^(for|client)$/i, 'For'],
	[/^(advisors?|collaborators?|contributors?)$/i, 'With'],
	[/^(tools?|stack|software)$/i, 'Tools'],
	[/^references?$/i, 'Reference'],
	[/^status$/i, 'Status'],
];
const KEY_RE = /(Course|Instructors?|Project Duration|Duration|Team members?|Project team|Team|My Role|Role|Spe(?:a)?cial Thanks|Thanks|For|Client|Advisors?|Collaborators?|Contributors?|Tools?|Stack|Software|References?|Status)\s*:/g;
const canon = (k: string) => KEYS.find(([re]) => re.test(k.trim()))?.[1] ?? null;

function parseCredits(html: string) {
	let text = html
		.replace(/<\/p>\s*<p>/g, '\n')
		.replace(/<br\s*\/?>/g, '\n')
		.replace(/<[^>]+>/g, '');
	// The old site sometimes ran lines together ("MethodsInstructor:"): break before every key
	text = text.replace(KEY_RE, (m, _k, offset: number) => (offset > 0 && text[offset - 1] !== '\n' ? '\n' + m : m));
	const facts: { key: string; value: string[] }[] = [];
	const rest: string[] = [];
	let current: { key: string; value: string[] } | null = null;
	for (const raw of text.split('\n')) {
		const line = raw.trim();
		if (!line) continue;
		const m = line.match(/^([A-Za-z][A-Za-z ]{1,20}?)\s*:\s*(.*)$/);
		const key = m ? canon(m[1]) : null;
		if (key) {
			current = { key, value: m![2] ? [m![2].trim()] : [] };
			facts.push(current);
		} else if (current) {
			current.value.push(line); // continuation, e.g. "[1] Proposed…" under "My Role:"
		} else {
			rest.push(line);
		}
	}
	return { facts, rest };
}

const credits: { key: string; value: string[] }[] = [];
const creditLines: string[] = [];
while (blocks[0]?.type === 'text' && blocks[0].kind === 'credits') {
	const { facts, rest } = parseCredits(blocks.shift()!.html);
	credits.push(...facts);
	creditLines.push(...rest);
}
const roleFact = credits.find((c) => c.key === 'Role');
const smallFacts = credits.filter((c) => c !== roleFact);

// Don't repeat the hero if the page opens with that same image
const dupAt = blocks.findIndex((b, i) => i < 3 && 'src' in b && study?.hero && b.src === study.hero.src);
if (dupAt >= 0) blocks = [...blocks.slice(0, dupAt), ...blocks.slice(dupAt + 1)];

// Opener: when the page has a top picture and opens with a statement and/or an intro paragraph,
// picture and words share one row (picture left, words right) instead of the picture running
// full width with the words floating under it.
const isIntro = (b: any) => b?.type === 'text' && b.kind !== 'section' && b.kind !== 'credits' && (b.kind === 'quote' || /<p>/.test(b.html));
let opener: any = null;
if (study?.hero && !study.heroWidth && !study.heroCaption && isIntro(blocks[0])) {
	const words: any[] = [blocks[0]];
	if (isIntro(blocks[1]) && (blocks[0] as any).kind !== (blocks[1] as any).kind) words.push(blocks[1]);
	words.sort((a, b) => (b.kind === 'quote' ? 1 : 0) - (a.kind === 'quote' ? 1 : 0)); // statement first
	const portrait = study.hero.height > study.hero.width;
	const picture = study.link ? { ...study.hero, href: study.link } : study.hero;
	opener = { type: 'row', columns: [{ flex: portrait ? 0.4 : 0.5, blocks: [picture] }, { flex: portrait ? 0.6 : 0.5, blocks: words }] };
	blocks = [opener, ...blocks.slice(words.length)];
}
const showHero = !!study?.hero && !opener;

// Without a top picture, the opening statement or paragraph becomes the lead beside the title
let lead: string | null = null;
const first = blocks[0];
const firstText = first?.type === 'text' ? first.html.replace(/<[^>]+>/g, ' ').trim() : '';
if (!study?.hero && first?.type === 'text' && first.kind !== 'section' && first.kind !== 'credits' && (first.kind === 'quote' || /<p>/.test(first.html) || firstText.length >= 40)) {
	lead = first.html;
	blocks = blocks.slice(1);
}
const hasBody = study && !study.locked && blocks.length > 0;

const shareImage = study?.hero?.type === 'image' ? (await getImage({ src: workImage(study.hero.src), width: 1200, format: 'jpeg' })).src : undefined;
---

<Base title={project.title} description={`${project.title} — ${project.summary}`} image={shareImage}>
	<article>
		<header class="head intro">
			<div class="head-l">
				<p class="code">{projectCode(project)}</p>
				<h1>{project.title}</h1>
				<dl class="facts">
					<div><dt>Type</dt><dd>{project.summary}</dd></div>
					{project.context && <div><dt>With</dt><dd>{project.context}</dd></div>}
					{smallFacts.map((c) => (
						<div><dt>{c.key}</dt><dd>{c.value.join(', ')}</dd></div>
					))}
				</dl>
				{creditLines.length > 0 && <p class="credits">{creditLines.map((l) => <span>{l}</span>)}</p>}
				{
					roleFact && (
						<div class="role">
							<span class="role-label">Role</span>
							<ul>
								{roleFact.value.map((v) => (
									<li>{v.replace(/^\[\d+\]\s*/, '')}</li>
								))}
							</ul>
						</div>
					)
				}
			</div>
			{lead && <div class="head-r lead" set:html={lead} />}
		</header>

		{
			showHero && study?.hero && (
				<div class:list={['hero', { wide: study.heroWidth === 'wide' || study.heroWidth === 'half', half: study.heroWidth === 'half' }]}>
					{study.link ? (
						<a href={study.link} target="_blank" rel="noopener" aria-label={`${project.title} — open link`}>
							<Media block={study.hero} alt={project.title} sizes="100vw" eager portrait={study.hero.height > study.hero.width} />
						</a>
					) : (
						<Media block={study.hero} alt={project.title} sizes="100vw" eager portrait={study.hero.height > study.hero.width} />
					)}
					{study.heroCaption && <p class="hero-cap">{study.heroCaption}</p>}
				</div>
			)
		}

		{
			hasBody ? (
				<div class="body">
					<Blocks blocks={blocks} title={project.title} />
				</div>
			) : (
				!study?.hero && (
					<div class="notice">
						<p>{study?.locked ? 'Details of this project are available on request.' : 'Case study coming soon.'}</p>
						<a href="mailto:this.kaizhang@gmail.com">Get in touch →</a>
					</div>
				)
			)
		}
	</article>

	<a class="next" href={`/work/${next.slug}/`}>
		<span class="next-text">
			<span class="label">Next project</span>
			<span class="next-title">{next.title}</span>
			<span class="next-summary">{next.summary}{next.context && ` @ ${next.context}`}</span>
			<span class="next-arrow" aria-hidden="true">→</span>
		</span>
		{
			nextImg && (
				<span class="next-img">
					<Image src={nextImg} alt="" widths={[640, 1000, 1400]} sizes="(max-width: 800px) 100vw, 55vw" loading="lazy" />
				</span>
			)
		}
	</a>
</Base>

<style>
	.head {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(12px, 1.6vw, 24px);
		row-gap: 32px;
		align-items: end;
		padding-top: clamp(40px, 8vh, 96px);
		margin-bottom: clamp(32px, 5vw, 64px);
	}
	.head-l {
		grid-column: 1 / 7;
	}
	.head-r {
		grid-column: 8 / 13;
	}
	.code {
		font: 12px var(--mono);
		letter-spacing: 0.04em;
		color: var(--muted);
		margin: 0 0 16px;
	}
	h1 {
		font-size: clamp(32px, 4.4vw, 60px);
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.025em;
		margin: 0 0 28px;
		text-wrap: balance;
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(9rem, 1fr));
		gap: 14px 20px;
		margin: 0;
		padding-top: 16px;
		border-top: 1px solid var(--line);
		font-size: 13px;
		line-height: 1.45;
	}
	dt {
		font: 10px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		margin-bottom: 5px;
	}
	dd {
		margin: 0;
	}
	.credits {
		display: flex;
		flex-direction: column;
		margin: 16px 0 0;
		font: 13px/1.55 var(--text);
		color: var(--muted);
	}
	.role {
		margin-top: 20px;
		padding-top: 14px;
		border-top: 1px solid var(--line);
	}
	.role-label {
		display: block;
		font: 10px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		margin-bottom: 8px;
	}
	.role ul {
		margin: 0;
		padding: 0;
		list-style: none;
		font: 13px/1.5 var(--text);
		max-width: 32rem;
	}
	/* Hanging bullets: the dash sits in its own gutter so wrapped lines align with the text */
	.role li {
		display: grid;
		grid-template-columns: 18px 1fr;
		column-gap: 2px;
	}
	.role li + li {
		margin-top: 6px;
	}
	.role li::before {
		content: '';
		width: 10px;
		height: 1px;
		background: var(--muted);
		margin-top: calc(0.75em - 0.5px);
	}
	.lead :global(p) {
		font-family: var(--text);
		font-size: clamp(17px, 1.5vw, 21px);
		line-height: 1.45;
		font-weight: 400;
		margin: 0 0 0.8em;
		text-wrap: pretty;
	}
	.lead :global(p:last-child) {
		margin-bottom: 0;
	}
	.lead :global(h2),
	.lead :global(h3) {
		font-size: clamp(22px, 2.2vw, 32px);
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 0.6em;
	}
	.lead :global(h2 strong) {
		font-weight: inherit;
	}
	.hero {
		margin-bottom: clamp(48px, 7vw, 120px);
	}
	.hero :global(.media) {
		max-height: 78vh;
	}
	/* Two-thirds hero: same columns as the body, so text beside it below lines up with its edge */
	.hero.wide {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(12px, 1.6vw, 24px);
	}
	.hero.half > :global(*) {
		grid-column: 1 / 7 !important;
	}
	.hero-cap {
		font: 11px/1.5 var(--mono);
		color: var(--muted);
		letter-spacing: 0.02em;
		margin: 10px 0 0;
	}
	.hero.wide > :global(.hero-cap) {
		grid-column: 1 / -1 !important;
		margin-right: 0;
	}
	.hero.wide > :global(*) {
		grid-column: 1 / 9;
		min-width: 0;
		margin-right: calc(-1 * clamp(12px, 1.6vw, 24px)); /* ends exactly where column 9 (the text beside the logo) begins */
	}
	.hero.wide :global(.media) {
		width: calc(100% + clamp(12px, 1.6vw, 24px)); /* fills the gutter too, so its right edge is column 9 */
		max-width: none;
		max-height: none;
	}
	.hero.wide :global(.media.portrait) {
		width: auto; /* a tall picture keeps to the screen height instead of the column width */
		max-height: 78vh;
	}
	@media (max-width: 800px) {
		.hero.wide > :global(*) {
			grid-column: 1 / -1;
		}
	}
	.hero a {
		display: inline-block;
		max-width: 100%;
	}
	.body {
		padding-bottom: clamp(24px, 4vw, 64px);
	}
	.notice {
		padding: 48px 0;
		color: var(--muted);
	}
	.notice a {
		color: var(--accent);
	}

	/* Next project: title on the left, cover on the right, both react on hover */
	.next {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(12px, 1.6vw, 24px);
		align-items: end;
		margin-top: clamp(64px, 10vw, 140px);
		padding-top: 28px;
		border-top: 1px solid var(--line);
	}
	.next-text {
		grid-column: 1 / 6;
		display: flex;
		flex-direction: column;
		gap: 10px;
		padding-bottom: 8px;
	}
	.label {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.next-title {
		font-size: clamp(30px, 4vw, 56px);
		line-height: 1;
		font-weight: 700;
		letter-spacing: -0.025em;
		transition: color 0.25s ease;
	}
	.next-summary {
		font: 14px/1.5 var(--text);
		color: var(--muted);
	}
	.next-arrow {
		font-size: 24px;
		margin-top: 8px;
		transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.next-img {
		grid-column: 7 / 13;
		display: block;
		aspect-ratio: 32 / 25;
		overflow: hidden;
		background: var(--line);
	}
	.next-img :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.next:hover .next-title {
		color: var(--accent);
	}
	.next:hover .next-arrow {
		transform: translateX(8px);
	}
	.next:hover .next-img :global(img) {
		transform: scale(1.03);
	}
	@media (max-width: 800px) {
		.head-l,
		.head-r,
		.next-text,
		.next-img {
			grid-column: 1 / -1;
		}
		.next {
			row-gap: 24px;
		}
		.next-img {
			order: -1;
		}
	}
	@media (max-width: 800px) {
		/* A narrowed top picture is a phone-wide picture */
		.hero.wide > :global(*),
		.hero.half > :global(*) {
			grid-column: 1 / -1 !important;
		}
	}
</style>
