---
import Base from '../layouts/Base.astro';
import Gallery, { tile } from '../components/Gallery.astro';
import Life from '../components/Life.astro';
import { projects } from '../data/projects';

const tiles = projects.map(tile);
---

<Base>
	<section class="intro">
		<h1>
			Computational &amp; industrial designer building objects, tools, and interfaces
			between matter and computation.
		</h1>
	</section>
	<Life />

	<section class="index" aria-label="Projects">
		<div class="bar">
			<a class="switch" href="/list/">List view →</a>
		</div>

		<Gallery tiles={tiles} eager={6} />
	</section>
</Base>

<style>
	.intro {
		padding-block: clamp(28px, 5vh, 64px) clamp(24px, 3vw, 40px);
		max-width: 60rem;
	}
	.index {
		margin-top: clamp(40px, 4.5vw, 64px);
	}
	h1 {
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.08;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.meta {
		font-family: var(--mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-top: 24px;
	}
	.bar {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 20px;
	}
	.switch {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.switch:hover {
		color: var(--fg);
	}

</style>
