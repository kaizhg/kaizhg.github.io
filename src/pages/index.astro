---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import { projects, disciplines, projectCode, type Discipline } from '../data/projects';
import { getCaseStudy, workImage } from '../data/case-studies';

// Hero shot per project, revealed above the row on hover
const previews = Object.fromEntries(
	await Promise.all(
		projects.map(async (p) => {
			const hero = getCaseStudy(p.slug)?.hero;
			if (!hero || hero.type !== 'image') return [p.slug, null];
			const img = await getImage({ src: workImage(hero.src), width: 960, format: 'webp' });
			return [p.slug, img.src];
		}),
	),
);

const filters = Object.entries(disciplines) as [Discipline, string][];
---

<Base>
	<section class="intro">
		<h1>
			Computational &amp; industrial designer building objects, tools, and interfaces
			where hardware meets code.
		</h1>
		<p class="meta">RISD ID · Harvard GSD · Seattle, WA</p>
	</section>

	<section class="index" aria-label="Projects">
		<div class="filters" role="group" aria-label="Filter by discipline">
			<button type="button" data-filter="all" aria-pressed="true">All <sup>{projects.length}</sup></button>
			{
				filters.map(([key, label]) => (
					<button type="button" data-filter={key} aria-pressed="false">
						{label} <sup>{projects.filter((p) => p.discipline === key).length}</sup>
					</button>
				))
			}
		</div>

		<ol class="list">
			{
				projects.map((p) => (
					<li data-discipline={p.discipline}>
						<a href={`/work/${p.slug}/`}>
							<span class="code">{projectCode(p)}</span>
							<span class="title">{p.title}</span>
							<span class="summary">
								{p.summary}
								{p.context && <span class="context"> @ {p.context}</span>}
							</span>
							<span class="arrow" aria-hidden="true">→</span>
							{previews[p.slug] && (
								<span class="thumb" aria-hidden="true">
									<img src={previews[p.slug]} alt="" decoding="async" fetchpriority="low" />
								</span>
							)}
						</a>
					</li>
				))
			}
		</ol>
	</section>
</Base>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
	const rows = document.querySelectorAll<HTMLLIElement>('.list li');
	buttons.forEach((btn) =>
		btn.addEventListener('click', () => {
			const f = btn.dataset.filter;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
			rows.forEach((r) => (r.hidden = f !== 'all' && r.dataset.discipline !== f));
		}),
	);
</script>

<style>
	.intro {
		padding-block: clamp(64px, 14vh, 160px) 64px;
		max-width: 60rem;
	}
	h1 {
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.08;
		font-weight: 500;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.meta {
		font-family: var(--mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-top: 24px;
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}
	.filters button {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		background: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 6px 12px;
		cursor: pointer;
	}
	.filters button[aria-pressed='true'] {
		color: var(--bg);
		background: var(--fg);
		border-color: var(--fg);
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.list li[hidden] {
		display: none;
	}
	.list a {
		--thumb-h: 280px;
		position: relative;
		display: grid;
		grid-template-columns: minmax(14rem, 1.2fr) 2fr 2fr auto;
		gap: 1rem;
		align-items: baseline;
		padding: 14px 12px;
		margin-inline: -12px;
		border-bottom: 1px solid var(--line);
		/* Row highlight: fills in fast, fades out slowly (like zarki.net) */
		transition: background-color 0.5s ease, color 0.5s ease;
	}
	.code {
		font: 11px var(--mono);
		letter-spacing: 0.04em;
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.title {
		font-size: 18px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}
	.summary {
		color: var(--muted);
		font-size: 14px;
	}
	.arrow {
		transition: transform 0.2s ease;
	}
	.code,
	.summary {
		transition: color 0.5s ease;
	}

	/* Hero shot: anchored to the row's right half, grows upward from the row's bottom edge */
	.thumb {
		position: absolute;
		right: calc(12px + 1rem + 1.25em);
		bottom: 0;
		width: min(42%, 480px);
		height: 0;
		overflow: hidden;
		pointer-events: none;
		transition: height 0.25s cubic-bezier(0.4, 0, 0.6, 1);
	}
	.thumb img {
		position: absolute;
		left: 0;
		top: 50%;
		width: 100%;
		height: var(--thumb-h);
		object-fit: cover;
		transform: translateY(-50%);
		background: var(--line);
	}

	.list a:hover,
	.list a:focus-visible {
		background-color: var(--fg);
		color: var(--bg);
		outline: none;
		transition-duration: 0.2s;
	}
	.list a:hover .code,
	.list a:hover .summary,
	.list a:focus-visible .code,
	.list a:focus-visible .summary {
		color: var(--bg);
		opacity: 0.7;
		transition-duration: 0.2s;
	}
	.list a:hover .arrow,
	.list a:focus-visible .arrow {
		transform: translateX(4px);
	}
	.list a:hover .thumb,
	.list a:focus-visible .thumb {
		height: var(--thumb-h);
		transition: height 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.list a,
		.thumb,
		.list a:hover .thumb {
			transition-duration: 0.01s;
		}
	}
	@media (hover: none), (max-width: 720px) {
		.thumb {
			display: none;
		}
	}
	@media (max-width: 720px) {
		.list a {
			grid-template-columns: 1fr auto;
			gap: 4px 1rem;
		}
		.code {
			grid-column: 1 / -1;
		}
		.summary {
			grid-column: 1;
		}
		.arrow {
			grid-row: 2;
			grid-column: 2;
		}
	}
</style>
