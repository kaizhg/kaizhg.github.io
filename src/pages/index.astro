---
import Base from '../layouts/Base.astro';
import { projects, disciplines, projectCode, type Discipline } from '../data/projects';

const filters = Object.entries(disciplines) as [Discipline, string][];
---

<Base>
	<section class="intro">
		<h1>
			Computational &amp; industrial designer building objects, tools, and interfaces
			where hardware meets code.
		</h1>
		<p class="meta">RISD ID · Harvard GSD · Seattle, WA</p>
	</section>

	<section class="index" aria-label="Projects">
		<div class="filters" role="group" aria-label="Filter by discipline">
			<button type="button" data-filter="all" aria-pressed="true">All <sup>{projects.length}</sup></button>
			{
				filters.map(([key, label]) => (
					<button type="button" data-filter={key} aria-pressed="false">
						{label} <sup>{projects.filter((p) => p.discipline === key).length}</sup>
					</button>
				))
			}
		</div>

		<ol class="list">
			{
				projects.map((p) => (
					<li data-discipline={p.discipline}>
						<a href={`/work/${p.slug}/`}>
							<span class="code">{projectCode(p)}</span>
							<span class="title">{p.title}</span>
							<span class="summary">
								{p.summary}
								{p.context && <span class="context"> @ {p.context}</span>}
							</span>
							<span class="arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>
</Base>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
	const rows = document.querySelectorAll<HTMLLIElement>('.list li');
	buttons.forEach((btn) =>
		btn.addEventListener('click', () => {
			const f = btn.dataset.filter;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
			rows.forEach((r) => (r.hidden = f !== 'all' && r.dataset.discipline !== f));
		}),
	);
</script>

<style>
	.intro {
		padding-block: clamp(64px, 14vh, 160px) 64px;
		max-width: 60rem;
	}
	h1 {
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.08;
		font-weight: 500;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.meta {
		font-family: var(--mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-top: 24px;
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}
	.filters button {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		background: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 6px 12px;
		cursor: pointer;
	}
	.filters button[aria-pressed='true'] {
		color: var(--bg);
		background: var(--fg);
		border-color: var(--fg);
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.list li[hidden] {
		display: none;
	}
	.list a {
		display: grid;
		grid-template-columns: minmax(14rem, 1.2fr) 2fr 2fr auto;
		gap: 1rem;
		align-items: baseline;
		padding-block: 14px;
		border-bottom: 1px solid var(--line);
		transition: padding 0.2s ease, color 0.2s ease;
	}
	.code {
		font: 11px var(--mono);
		letter-spacing: 0.04em;
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.title {
		font-size: 18px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}
	.summary {
		color: var(--muted);
		font-size: 14px;
	}
	.arrow {
		transition: transform 0.2s ease;
	}
	.list a:hover {
		padding-left: 12px;
		color: var(--accent);
	}
	.list a:hover .arrow {
		transform: translateX(4px);
	}
	@media (max-width: 720px) {
		.list a {
			grid-template-columns: 1fr auto;
			gap: 4px 1rem;
		}
		.code {
			grid-column: 1 / -1;
		}
		.summary {
			grid-column: 1;
		}
		.arrow {
			grid-row: 2;
			grid-column: 2;
		}
	}
</style>
