---
import Base from '../layouts/Base.astro';
import Gallery, { tile } from '../components/Gallery.astro';
import Life from '../components/Life.astro';
import { projects, disciplines, type Discipline } from '../data/projects';

const tiles = projects.map(tile);
const filters = Object.entries(disciplines) as [Discipline, string][];
---

<Base>
	<section class="intro">
		<h1>
			Computational &amp; industrial designer building objects, tools, and interfaces
			where hardware meets code.
		</h1>
		<p class="meta">RISD ID · Harvard GSD · Seattle, WA</p>
	</section>
	<Life />

	<section class="index" aria-label="Projects">
		<div class="bar">
			<div class="filters" role="group" aria-label="Filter by discipline">
				<button type="button" data-filter="all" aria-pressed="true">All <sup>{projects.length}</sup></button>
				{
					filters.map(([key, label]) => (
						<button type="button" data-filter={key} aria-pressed="false">
							{label} <sup>{projects.filter((p) => p.discipline === key).length}</sup>
						</button>
					))
				}
			</div>
			<a class="switch" href="/list/">List view →</a>
		</div>

		<Gallery tiles={tiles} eager={6} />
	</section>
</Base>

<script>
	document.addEventListener('astro:page-load', () => {
	const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
	const rows = document.querySelectorAll<HTMLLIElement>('.grid li');
	buttons.forEach((btn) =>
		btn.addEventListener('click', () => {
			const f = btn.dataset.filter;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
			rows.forEach((t) => (t.hidden = f !== 'all' && t.dataset.discipline !== f));
		}),
	);
	});
</script>

<style>
	.intro {
		padding-block: clamp(56px, 10vh, 140px) clamp(40px, 6vw, 72px);
		max-width: 60rem;
	}
	.index {
		margin-top: clamp(56px, 8vw, 112px);
	}
	h1 {
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.08;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.meta {
		font-family: var(--mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-top: 24px;
	}
	.bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 20px;
	}
	.switch {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.switch:hover {
		color: var(--fg);
	}

</style>
