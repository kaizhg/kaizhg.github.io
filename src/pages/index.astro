---
import Base from '../layouts/Base.astro';
import { getImage } from 'astro:assets';
import { projects, disciplines, projectCode, type Discipline } from '../data/projects';
import { getCaseStudy, workImage } from '../data/case-studies';

// Hero shot per project, shown next to the cursor when a row is hovered
const previews = Object.fromEntries(
	await Promise.all(
		projects.map(async (p) => {
			const hero = getCaseStudy(p.slug)?.hero;
			if (!hero || hero.type !== 'image') return [p.slug, null];
			const img = await getImage({ src: workImage(hero.src), width: 720, format: 'webp' });
			return [p.slug, img.src];
		}),
	),
);

const filters = Object.entries(disciplines) as [Discipline, string][];
---

<Base>
	<section class="intro">
		<h1>
			Computational &amp; industrial designer building objects, tools, and interfaces
			where hardware meets code.
		</h1>
		<p class="meta">RISD ID · Harvard GSD · Seattle, WA</p>
	</section>

	<section class="index" aria-label="Projects">
		<div class="filters" role="group" aria-label="Filter by discipline">
			<button type="button" data-filter="all" aria-pressed="true">All <sup>{projects.length}</sup></button>
			{
				filters.map(([key, label]) => (
					<button type="button" data-filter={key} aria-pressed="false">
						{label} <sup>{projects.filter((p) => p.discipline === key).length}</sup>
					</button>
				))
			}
		</div>

		<ol class="list">
			{
				projects.map((p) => (
					<li data-discipline={p.discipline} data-preview={previews[p.slug] ?? undefined}>
						<a href={`/work/${p.slug}/`}>
							<span class="code">{projectCode(p)}</span>
							<span class="title">{p.title}</span>
							<span class="summary">
								{p.summary}
								{p.context && <span class="context"> @ {p.context}</span>}
							</span>
							<span class="arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>

	<div class="preview" aria-hidden="true">
		{
			projects.map(
				(p) => previews[p.slug] && <img src={previews[p.slug]} alt="" data-for={p.slug} decoding="async" />,
			)
		}
	</div>
</Base>

<script>
	// Hover preview: follow the cursor with the hovered project's hero shot (pointer devices only)
	const preview = document.querySelector<HTMLDivElement>('.preview')!;
	const shots = new Map<string, HTMLImageElement>();
	preview.querySelectorAll<HTMLImageElement>('img').forEach((img) => shots.set(img.dataset.for!, img));
	const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
	let x = 0, y = 0, raf = 0;
	const place = () => {
		raf = 0;
		const w = preview.offsetWidth, h = preview.offsetHeight;
		const left = Math.min(x + 24, window.innerWidth - w - 16);
		const top = Math.min(Math.max(y - h / 2, 16), window.innerHeight - h - 16);
		preview.style.transform = `translate(${left}px, ${top}px)`;
	};
	document.querySelectorAll<HTMLLIElement>('.list li').forEach((li) => {
		const slug = li.querySelector('a')!.getAttribute('href')!.split('/')[2];
		li.addEventListener('mouseenter', () => {
			if (!fine.matches || !shots.has(slug)) return;
			shots.forEach((img, k) => img.classList.toggle('on', k === slug));
			preview.classList.add('visible');
		});
		li.addEventListener('mouseleave', () => preview.classList.remove('visible'));
	});
	window.addEventListener('mousemove', (e) => {
		x = e.clientX;
		y = e.clientY;
		if (!raf) raf = requestAnimationFrame(place);
	});

	const buttons = document.querySelectorAll<HTMLButtonElement>('.filters button');
	const rows = document.querySelectorAll<HTMLLIElement>('.list li');
	buttons.forEach((btn) =>
		btn.addEventListener('click', () => {
			const f = btn.dataset.filter;
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
			rows.forEach((r) => (r.hidden = f !== 'all' && r.dataset.discipline !== f));
		}),
	);
</script>

<style>
	.intro {
		padding-block: clamp(64px, 14vh, 160px) 64px;
		max-width: 60rem;
	}
	h1 {
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.08;
		font-weight: 500;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.meta {
		font-family: var(--mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-top: 24px;
	}
	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 16px;
	}
	.filters button {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		background: none;
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 6px 12px;
		cursor: pointer;
	}
	.filters button[aria-pressed='true'] {
		color: var(--bg);
		background: var(--fg);
		border-color: var(--fg);
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.list li[hidden] {
		display: none;
	}
	.list a {
		display: grid;
		grid-template-columns: minmax(14rem, 1.2fr) 2fr 2fr auto;
		gap: 1rem;
		align-items: baseline;
		padding-block: 14px;
		border-bottom: 1px solid var(--line);
		transition: padding 0.2s ease, color 0.2s ease;
	}
	.code {
		font: 11px var(--mono);
		letter-spacing: 0.04em;
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.title {
		font-size: 18px;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}
	.summary {
		color: var(--muted);
		font-size: 14px;
	}
	.arrow {
		transition: transform 0.2s ease;
	}
	.list a:hover {
		padding-left: 12px;
		color: var(--accent);
	}
	.list a:hover .arrow {
		transform: translateX(4px);
	}
	.preview {
		position: fixed;
		top: 0;
		left: 0;
		width: clamp(240px, 28vw, 420px);
		aspect-ratio: 4 / 3;
		pointer-events: none;
		z-index: 20;
		opacity: 0;
		transition: opacity 0.2s ease;
	}
	.preview.visible {
		opacity: 1;
	}
	.preview img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transition: opacity 0.15s ease;
		box-shadow: 0 12px 40px rgb(0 0 0 / 0.18);
	}
	.preview img.on {
		opacity: 1;
	}
	@media (hover: none) {
		.preview {
			display: none;
		}
	}
	@media (max-width: 720px) {
		.list a {
			grid-template-columns: 1fr auto;
			gap: 4px 1rem;
		}
		.code {
			grid-column: 1 / -1;
		}
		.summary {
			grid-column: 1;
		}
		.arrow {
			grid-row: 2;
			grid-column: 2;
		}
	}
</style>
