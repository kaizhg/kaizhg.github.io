---
import Base from '../layouts/Base.astro';
import Gallery, { tile } from '../components/Gallery.astro';
import { archive } from '../data/projects';

const tiles = archive.map(tile);
---

<Base title="Archive" description="Older and smaller work by Kai Zhang.">
	<section class="intro">
		<h1>Archive</h1>
		<p class="meta">Earlier and smaller work, 2018 – 2023</p>
	</section>

	<section class="index" aria-label="Archive projects">
		<div class="bar">
			<a class="switch" href="/archive/list/">List view →</a>
		</div>
		<Gallery tiles={tiles} cols={4} small eager={8} />
	</section>
</Base>

<style>
	.intro {
		padding-block: clamp(48px, 10vh, 120px) 48px;
	}
	h1 {
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.08;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0;
	}
	.meta {
		font-family: var(--mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-top: 20px;
	}
	.bar {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 20px;
	}
	.switch {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.switch:hover {
		color: var(--fg);
	}
</style>
