---
import { Image } from 'astro:assets';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import Base from '../layouts/Base.astro';
import { workImage } from '../data/case-studies';

// Photos come from content/about/about.md: one `![](file "caption")` line per picture
const photos = readFileSync(join(process.cwd(), 'content/about/about.md'), 'utf8')
	.split('\n')
	.map((l) => l.match(/^!\[\]\(([^)\s]+)(?:\s+"([^"]*)")?\)/))
	.filter((m): m is RegExpMatchArray => !!m)
	.map((m) => ({ src: workImage(`about/${m[1]}`), caption: m[2] ?? '' }));
---

<Base title="About" description="Kai Zhang — computational and industrial designer. RISD ID, Harvard GSD. Based in Seattle.">
	<section class="about">
		<div class:list={['text', { pinned: photos.length > 1 }]}>
			<h1>
				I'm Kai Zhang, a computational and industrial designer. Born and raised in Shenzhen, now
				based in Seattle.
			</h1>
			<div class="body">
				<p>
					Professionally I've worked across computational design, 3D printing, and ODM/OEM product
					development, taking ideas from generative models to production lines.
				</p>
				<p>
					I studied industrial design at the Rhode Island School of Design and graduated from the
					Harvard Graduate School of Design. My work spans industrial, computational, and interaction
					design: objects, tools, and interfaces between matter and computation.
				</p>
				<p>
					I enjoy sketching bizarre ideas, seeking out new aesthetic forms, solving problems with a
					non-linear approach, and exploring new workflows.
				</p>
				<p>
					In my spare time I'm either out in nature or in places with high analog information
					density, like a PCB assembly factory, a fish market, or an old urban village. Both refresh
					my mind really well.
				</p>
			</div>

			<dl class="facts">
				<div>
					<dt>Education</dt>
					<dd>Harvard GSD, MDes<br />RISD, BFA Industrial Design</dd>
				</div>
				<div>
					<dt>Based in</dt>
					<dd>Seattle, WA</dd>
				</div>
				<div>
					<dt>Contact</dt>
					<dd>
						<a href="mailto:this.kaizhang@gmail.com">this.kaizhang@gmail.com</a><br />
						<span class="muted">Write for a résumé.</span>
					</dd>
				</div>
				<div>
					<dt>Elsewhere</dt>
					<dd>
						<a href="https://www.linkedin.com/in/kai-zhang-653411223/">LinkedIn</a><br />
						<a href="https://www.instagram.com/zalvink_/">Instagram</a><br />
						<a href="https://github.com/kaizhg">GitHub</a><br />
						<a href="https://fab.cba.mit.edu/classes/863.23/Harvard/people/Kai/index.html">HTMAA 2023, MIT</a>
					</dd>
				</div>
			</dl>
		</div>

		<div class:list={['photos', { single: photos.length === 1 }]}>
			{
				photos.map((ph, i) => (
					<figure class:list={['photo', 'reveal', { wide: ph.src.width > ph.src.height }]}>
						<Image
							src={ph.src}
							alt={ph.caption || 'Kai Zhang'}
							widths={[720, 1200, 1800]}
							sizes="(max-width: 900px) 100vw, 50vw"
							loading={i === 0 ? 'eager' : 'lazy'}
						/>
						{ph.caption && <figcaption>{ph.caption}</figcaption>}
					</figure>
				))
			}
		</div>
	</section>
</Base>

<style>
	.about {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(12px, 1.6vw, 24px);
		row-gap: 48px;
		align-items: start;
		padding-top: clamp(40px, 8vh, 96px);
	}
	.text {
		grid-column: 1 / 6;
		max-width: 34rem;
	}
	/* Photos: landscapes take the whole column, portraits sit in pairs */
	.photos {
		grid-column: 7 / 13;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(16px, 1.6vw, 24px);
		align-items: start;
	}
	.photo {
		margin: 0;
	}
	.photo.wide {
		grid-column: 1 / -1;
	}
	/* One side stays put while the other scrolls: a lone portrait rides along with the text,
	   a set of photos scrolls past the pinned text */
	.photos.single,
	.text.pinned {
		position: sticky;
		top: 32px;
	}
	.photo :global(img) {
		width: 100%;
		height: auto;
		display: block;
		background: var(--line);
	}
	figcaption {
		font: 11px/1.5 var(--mono);
		color: var(--muted);
		margin-top: 10px;
		letter-spacing: 0.02em;
		max-width: 44rem;
	}
	/* Same voice as the statement on a project page */
	h1 {
		font-size: clamp(24px, 2.6vw, 38px);
		line-height: 1.15;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 32px;
		text-wrap: balance;
	}
	.body p {
		font-family: var(--text);
		font-size: 17px;
		line-height: 1.6;
		margin: 0 0 1.1em;
	}
	.muted {
		color: var(--muted);
	}
	.facts {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 24px;
		margin: 56px 0 0;
		padding-top: 20px;
		border-top: 1px solid var(--line);
	}
	dt {
		font: 10px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
		margin-bottom: 6px;
	}
	dd {
		margin: 0;
		font-size: 14px;
		line-height: 1.6;
	}
	dd a:hover {
		color: var(--accent);
	}
	@media (max-width: 900px) {
		.text,
		.photos {
			grid-column: 1 / -1;
		}
		.photos,
		.text.pinned {
			position: static;
		}
	}
</style>
