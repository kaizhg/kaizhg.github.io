---
import Base from '../layouts/Base.astro';
import List from '../components/List.astro';
import Life from '../components/Life.astro';
import { projects } from '../data/projects';
---

<Base title="List">
	<section class="intro">
		<h1>
			Computational &amp; industrial designer building objects, tools, and interfaces
			between matter and computation.
		</h1>
	</section>
	<Life />
	<div class="index">
		<List items={projects} gridHref="/" />
	</div>
</Base>

<style>
	/* Same rhythm as the grid view: intro, Life band, then the projects */
	.intro {
		padding-block: clamp(28px, 5vh, 64px) clamp(24px, 3vw, 40px);
		max-width: 60rem;
	}
	.index {
		margin-top: clamp(40px, 4.5vw, 64px);
	}
	h1 {
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.08;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0;
	}
</style>
