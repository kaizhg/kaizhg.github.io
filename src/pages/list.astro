---
import Base from '../layouts/Base.astro';
import List from '../components/List.astro';
import { projects } from '../data/projects';
---

<Base title="List">
	<section class="intro">
		<h1>
			Computational &amp; industrial designer building objects, tools, and interfaces
			where hardware meets code.
		</h1>
	</section>
	<List items={projects} gridHref="/" />
</Base>

<style>
	.intro {
		padding-block: clamp(64px, 14vh, 160px) 64px;
		max-width: 60rem;
	}
	h1 {
		font-size: clamp(28px, 4.2vw, 56px);
		line-height: 1.08;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0;
	}
</style>
