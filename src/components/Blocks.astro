---
import Media from './Media.astro';
import type { Block } from '../data/case-studies';

interface Props {
	blocks: Block[];
	title: string;
	nested?: boolean;
}

const { blocks, title, nested = false } = Astro.props;
const aspect = (b: { width: number; height: number }) => b.width / b.height;
---

{
	blocks.map((b) => {
		switch (b.type) {
			case 'text':
				return <div class="block text" set:html={b.html} />;
			case 'image':
				return (
					<figure class="block media-block">
						<Media block={b} alt={b.caption ?? title} sizes={nested ? '(max-width: 800px) 100vw, 50vw' : undefined} />
						{b.caption && <figcaption set:html={b.caption} />}
					</figure>
				);
			case 'loop':
			case 'video':
				return (
					<figure class="block media-block">
						<Media block={b} />
					</figure>
				);
			case 'youtube':
				return (
					<div class="block embed">
						<iframe
							src={`https://www.youtube-nocookie.com/embed/${b.id}`}
							title={`${title} video`}
							loading="lazy"
							allow="autoplay; picture-in-picture; fullscreen"
							allowfullscreen
						/>
					</div>
				);
			case 'gallery':
				return (
					<div class="block gallery">
						{b.items.map((it) => (
							<div class="cell" style={`flex: ${aspect(it)}`}>
								<Media block={it} alt={title} sizes="(max-width: 800px) 100vw, 40vw" />
							</div>
						))}
					</div>
				);
			case 'row':
				return (
					<div class="block row">
						{b.columns.map((c) => (
							<div class="col" style={`flex: ${c.flex}`}>
								<Astro.self blocks={c.blocks} title={title} nested />
							</div>
						))}
					</div>
				);
		}
	})
}

<script>
	// Play looping clips only while they are on screen
	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				const v = e.target as HTMLVideoElement;
				if (e.isIntersecting) v.play().catch(() => {});
				else v.pause();
			}
		},
		{ rootMargin: '200px 0px' },
	);
	document.querySelectorAll<HTMLVideoElement>('video[loop]').forEach((v) => io.observe(v));
</script>

<style>
	.block {
		margin-block: 0 clamp(32px, 5vw, 64px);
	}
	.media-block {
		margin-inline: 0;
	}
	figcaption {
		font: 12px var(--mono);
		color: var(--muted);
		margin-top: 10px;
		letter-spacing: 0.02em;
	}
	.text {
		max-width: 44rem;
	}
	.row .text {
		max-width: none;
	}
	.text :global(h2) {
		font-size: clamp(26px, 3.2vw, 44px);
		line-height: 1.1;
		font-weight: 500;
		letter-spacing: -0.02em;
		margin: 0 0 0.6em;
	}
	.text :global(h2 strong) {
		font-weight: inherit;
	}
	.text :global(h3) {
		font-size: clamp(19px, 1.8vw, 24px);
		line-height: 1.3;
		font-weight: 500;
		letter-spacing: -0.01em;
		margin: 1.4em 0 0.5em;
	}
	.text :global(h3:first-child) {
		margin-top: 0;
	}
	.text :global(p),
	.text :global(li) {
		font-size: 16px;
		line-height: 1.65;
		margin: 0 0 1em;
	}
	.text :global(p.caption) {
		font: 12px/1.5 var(--mono);
		color: var(--muted);
	}
	.text :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.embed {
		position: relative;
		aspect-ratio: 16 / 9;
		max-width: 100%;
	}
	.embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.gallery,
	.row {
		display: flex;
		gap: clamp(8px, 1.5vw, 20px);
		align-items: flex-start;
	}
	.row {
		gap: clamp(16px, 3vw, 48px);
		align-items: center;
	}
	.col,
	.cell {
		min-width: 0;
	}
	.col > :global(.block:last-child) {
		margin-bottom: 0;
	}
	@media (max-width: 800px) {
		.row {
			flex-direction: column;
			align-items: stretch;
		}
		.row .col {
			flex: none !important;
		}
		.gallery {
			flex-wrap: wrap;
		}
		.gallery .cell {
			flex-basis: 100% !important;
		}
		.col > :global(.block:last-child) {
			margin-bottom: clamp(32px, 5vw, 64px);
		}
	}
</style>
