---
/**
 * Renders a case study's blocks.
 *
 * Top level: a 12-column magazine grid. Each block may carry a `layout` (assigned by
 * scripts/plan-layout.py, by eye per project); blocks without one fall back to simple
 * rules — images alternate sides and pair up, text sits in a narrow measure, headings
 * become section labels or pull quotes. Cells are placed in order; a left cell followed
 * by a right cell shares its row (text-l + half-r, wide-l + beside-r). A layout ending in
 * ' pull' is rendered before the previous cell, so text can sit beside the image that
 * precedes it in the story.
 *
 * Nested (inside a row column): plain linear rendering.
 */
import Media from './Media.astro';
import type { Block, MediaBlock } from '../data/case-studies';

interface Props {
	blocks: Block[];
	title: string;
	nested?: boolean;
}

const { blocks, title, nested = false } = Astro.props;

type Laid = Block & { layout?: string; kind?: string };
const isImg = (b: Block): b is MediaBlock => b.type === 'image' || b.type === 'loop';
const ratio = (b: MediaBlock) => b.width / b.height;
const landscape = (b: MediaBlock) => ratio(b) >= 1.25;
const portrait = (b: MediaBlock) => ratio(b) < 0.9;

interface Cell {
	cls: string;
	blocks: Block[];
	fitH?: string;
}

// Text that may sit beside an image: unplanned, or planned as a plain side column
const plainText = (b?: Laid) =>
	!!b && b.type === 'text' && (!b.layout || /^text-[lr]( low)?$/.test(b.layout)) && (b.kind === 'text' || !b.kind) &&
	!/<h[23]>/.test(b.html) && b.html.replace(/<[^>]+>/g, '').length < 900;
const sideOf = (cls?: string) => (cls && /-l\b/.test(cls) ? 'l' : cls && /-r\b/.test(cls) ? 'r' : null);
// Text cell that shares the row with an image cell of the given class, bottom-aligned
const BESIDE: Record<string, [string, 'before' | 'after']> = {
	'wide-r': ['pair-before-wide', 'before'],
	'half-r': ['pair-before-half', 'before'],
	'narrow-r': ['pair-before-narrow', 'before'],
	'third-r': ['pair-before-narrow', 'before'],
	'wide-l': ['pair-after-wide', 'after'],
	'half-l': ['pair-after-half', 'after'],
	'narrow-l': ['pair-after-narrow', 'after'],
	'third-l': ['pair-after-narrow', 'after'],
};

function layout(bs: Laid[]): Cell[] {
	const cells: Cell[] = [];
	let side: 'l' | 'r' = 'r';
	let singles = 0;
	const flip = () => (side = side === 'l' ? 'r' : 'l');

	for (let i = 0; i < bs.length; i++) {
		const b = bs[i];
		const next = bs[i + 1];

		// Push a media cell; if plain text follows and there is room beside the image,
		// the text joins the same row, aligned to the image's bottom edge (magazine style)
		const pushMedia = (cls: string) => {
			const beside = BESIDE[cls.replace(/ stagger$/, '')];
			// {text-r} after a right-hand picture would be pulled to its left: it keeps its own row instead
			if (beside && plainText(next) && !(beside[1] === 'before' && next!.layout?.startsWith('text-r'))) {
				const [tcls0, where] = beside;
				const tcls = tcls0 + (/\blow\b/.test(next!.layout ?? '') ? ' low' : '');
				if (where === 'before') cells.push({ cls: tcls, blocks: [next] }, { cls, blocks: [b] });
				else cells.push({ cls, blocks: [b] }, { cls: tcls, blocks: [next] });
				i++;
			} else cells.push({ cls, blocks: [b] });
			if (/-l\b/.test(cls)) side = 'r';
			else if (/-r\b/.test(cls)) side = 'l';
		};

		// Explicit decision from the plan (gallery/row layouts are handled inside the block)
		if (b.layout && b.type !== 'gallery' && b.type !== 'row') {
			if (b.layout === 'skip') continue;
			if (/ pull$/.test(b.layout)) cells.splice(cells.length - 1, 0, { cls: b.layout.replace(/ pull$/, ''), blocks: [b] });
			else if (b.type === 'text') {
				// A planned side text followed by a planned image on the other side: pair them on one row
				const nb = next?.layout?.replace(/ stagger$/, '');
				if (/^text-[lr]$/.test(b.layout) && next && nb && BESIDE[nb] && sideOf(nb) !== sideOf(b.layout)) {
					const [tcls, where] = BESIDE[nb];
					if (where === 'before') cells.push({ cls: tcls, blocks: [b] }, { cls: next.layout!, blocks: [next] });
					else cells.push({ cls: next.layout!, blocks: [next] }, { cls: tcls, blocks: [b] });
					i++;
					side = sideOf(nb) === 'l' ? 'r' : 'l';
					continue;
				}
				// A right-hand text followed by a left-hand picture: the picture must come first in the
				// grid or the browser starts a new row for it; keep the picture's own classes and the text's
				if (/^text-r\b/.test(b.layout) && next && nb && sideOf(nb) === 'l' && (next.type === 'image' || next.type === 'loop')) {
					cells.push({ cls: next.layout!, blocks: [next] }, { cls: b.layout, blocks: [b] });
					i++;
					side = 'r';
					continue;
				}
				cells.push({ cls: b.layout, blocks: [b] });
			} else pushMedia(b.layout);
			if (/-l\b/.test(b.layout)) side = 'r';
			else if (/-r\b/.test(b.layout)) side = 'l';
			continue;
		}

		// A staggered pair of photos followed by text: the text tucks under the first photo
		if (b.type === 'row' && plainText(next)) {
			const media = b.columns.flatMap((c) => c.blocks);
			const photos = media.length > 0 && media.every((m) => m.type === 'image' || m.type === 'loop' || m.type === 'video' || m.type === 'gallery');
			if (photos && b.columns.length === 2 && b.layout !== 'flat') {
				const merged = { ...b, columns: [{ ...b.columns[0], blocks: [...b.columns[0].blocks, next!] }, b.columns[1]] };
				cells.push({ cls: 'full', blocks: [merged] });
				i++;
				continue;
			}
		}

		if (b.type === 'text') {
			if (b.kind === 'credits') cells.push({ cls: 'credits', blocks: [b] });
			else if (b.kind === 'section') cells.push({ cls: 'section', blocks: [b] });
			else if (b.kind === 'quote') cells.push({ cls: 'quote', blocks: [b] });
			else if (/<h[23]>/.test(b.html)) cells.push({ cls: 'intro', blocks: [b] }); // a heading opens a section
			else cells.push({ cls: 'text-l', blocks: [b] });
			continue;
		}

		if (isImg(b) && next && isImg(next) && !next.layout) {
			const flat = b.kind === 'white' || next.kind === 'white' ? '' : ' stagger';
			if (landscape(b) && landscape(next)) {
				cells.push({ cls: 'half-l', blocks: [b] }, { cls: 'half-r' + flat, blocks: [next] });
			} else if (portrait(b) && portrait(next)) {
				cells.push({ cls: 'third-l', blocks: [b] }, { cls: 'third-r' + flat, blocks: [next] });
			} else if (portrait(next)) {
				cells.push({ cls: 'wide-l', blocks: [b] }, { cls: 'narrow-r' + flat, blocks: [next] });
			} else {
				cells.push({ cls: 'narrow-l', blocks: [b] }, { cls: 'wide-r' + flat, blocks: [next] });
			}
			i++;
			side = 'l';
			continue;
		}

		if (isImg(b)) {
			// Images anchor to the left edge; the text that explains them sits to their right
			if (b.kind === 'white') {
				pushMedia(landscape(b) ? 'wide-l' : 'half-l'); // diagrams never go full-bleed
			} else if (portrait(b)) {
				pushMedia('narrow-l');
			} else if (landscape(b)) {
				if (ratio(b) >= 1.6 && singles % 2 === 0) cells.push({ cls: 'full', blocks: [b] });
				else pushMedia('wide-l');
				singles++;
			} else {
				pushMedia('half-l');
			}
			continue;
		}

		// a gallery may ask for a column range: "[gallery grid3 @2-12]"
		cells.push({ cls: (b.type === 'gallery' && b.layout?.match(/@\d+-\d+/)?.[0]) || 'full', blocks: [b] });
	}
	return cells;
}

const cells = nested ? [] : layout(blocks as Laid[]);

// Column range of a cell class on the 12-column grid ("@3-7" = grid-column: 3 / 7)
const RANGES: Record<string, [number, number]> = {
	full: [1, 13], 'wide-l': [1, 9], 'wide-r': [5, 13], 'wide-c': [3, 11], 'half-l': [1, 7], 'half-r': [7, 13],
	'narrow-l': [1, 6], 'narrow-r': [8, 13], 'narrow-c': [4, 10], 'third-l': [2, 6], 'third-r': [8, 12],
	'small-l': [1, 5], 'small-c': [5, 9], 'small-r': [9, 13], 'tri-a': [1, 5], 'tri-b': [5, 9], 'tri-c': [9, 13],
};
const rangeOf = (cls: string): [number, number] | null => {
	const m = cls.match(/@(\d+)-(\d+)/);
	if (m) return [+m[1], +m[2]];
	return RANGES[cls.replace(/ (stagger|low|pull)\b/g, '').trim()] ?? null;
};
// Width of a span of columns, in container units: n columns plus the gutters between them
const colw = (span: number) => `((100cqw - 11 * var(--gap)) / 12 * ${span} + ${span - 1} * var(--gap))`;
const cellStyle = (c: Cell) => {
	const parts: string[] = [];
	const m = c.cls.match(/@(\d+)-(\d+)/);
	if (m) parts.push(`grid-column: ${m[1]} / ${m[2]}`);
	if (c.fitH) parts.push(`--fit-h: ${c.fitH}`);
	return parts.length ? parts.join('; ') : undefined;
};
// Two single pictures side by side on one row get exactly the same height: the lower of the
// two natural heights, computed from real column widths (gutters included) so nothing drifts.
// The taller shape loses a sliver to object-fit.
for (let i = 0; i + 1 < cells.length; i++) {
	const a = cells[i], b = cells[i + 1];
	const pic = (c: Cell) => c.blocks.length === 1 && (c.blocks[0].type === 'image' || c.blocks[0].type === 'loop') ? (c.blocks[0] as any) : null;
	const pa = pic(a), pb = pic(b);
	const ra = rangeOf(a.cls), rb = rangeOf(b.cls);
	if (!pa || !pb || !ra || !rb || rb[0] < ra[1] || / stagger\b/.test(a.cls + b.cls)) continue;
	const hA = `calc(${colw(ra[1] - ra[0])} / ${(pa.width / pa.height).toFixed(4)})`;
	const hB = `calc(${colw(rb[1] - rb[0])} / ${(pb.width / pb.height).toFixed(4)})`;
	a.fitH = b.fitH = `min(${hA}, ${hB})`;
}
const galleryClass = (b: Laid) => {
	const l = (b.layout ?? '').replace(/@\d+-\d+/, '').trim();
	return /^(grid\d|strip|stack|carousel)$/.test(l) ? l : 'flow';
};
---

{
	nested ? (
		(blocks as Laid[]).map((b) => {
			switch (b.type) {
				case 'text':
					return <div class:list={['block', 'text', { credits: b.kind === 'credits' }]} set:html={b.html} />;
				case 'image':
					return (
						<figure class="block media-block reveal">
							{b.href ? (
								<a href={b.href} target="_blank" rel="noopener" class="media-link">
									<Media block={b} alt={b.caption ?? title} sizes="(max-width: 800px) 100vw, 60vw" />
								</a>
							) : (
								<Media block={b} alt={b.caption ?? title} sizes="(max-width: 800px) 100vw, 60vw" />
							)}
							{b.caption && <figcaption set:html={b.caption} />}
						</figure>
					);
				case 'loop':
				case 'video':
					return (
						<figure class="block media-block reveal">
							<Media block={b} sizes="(max-width: 800px) 100vw, 60vw" />
						</figure>
					);
				case 'youtube':
					return (
						<div class="block embed reveal">
							<iframe
								src={`https://www.youtube.com/embed/${b.id}${b.start ? `?start=${b.start}` : ''}`}
								title={`${title} video`}
								referrerpolicy="strict-origin-when-cross-origin"
								loading="lazy"
								allow="autoplay; picture-in-picture; fullscreen"
								allowfullscreen
							/>
						</div>
					);
				case 'cluster': {
					// Free composition on the 12-column grid: each picture names its columns (@a-b) and a
					// vertical offset (y=, in half-column units); heights follow the pictures' shapes.
					const G = 0.245; // gutter as a fraction of a column (clamp(12px,1.6vw,24px) vs (W-11g)/12)
					const unit = (1 + G) / 2; // one grid row = half a column
					const place = (it: any) => {
						const [, a, b] = it.layout.match(/@(\d+)-(\d+)/)!;
						const span = +b - +a;
						const widthCols = span + (span - 1) * G;
						const rows = Math.max(1, Math.round(widthCols / (it.width / it.height) / unit));
						return `grid-column: ${a} / ${b}; grid-row: ${(it.y ?? 0) + 1} / span ${rows}`;
					};
					return (
						<div class="block cluster reveal">
							{b.items.map((it) => (
								<figure class="cell-flex" style={place(it)}>
									<Media block={it} alt={(it as any).caption ?? title} sizes="(max-width: 800px) 100vw, 40vw" />
									{(it as any).caption && <figcaption class="hover-cap">{(it as any).caption}</figcaption>}
								</figure>
							))}
						</div>
					);
				}
				case 'gallery': {
					const cls = galleryClass(b);
					const ratios = b.items.map((it) => it.width / it.height).sort((a, c) => a - c);
					const ar = ratios[Math.floor(ratios.length / 2)];
					const plates = cls !== 'flow' && b.items.every((it) => (it as Laid).kind === 'white');
					// Carousel: one slide at a time, advancing on its own, arrows to step through
					if (cls === 'carousel') {
						return (
							<div class:list={['block', 'gallery', 'reveal', 'carousel', { plates }]} style={`--ar: ${ar.toFixed(4)}`} data-carousel data-interval="4000">
								<div class="slides" role="group" aria-roledescription="carousel" aria-label={`${title} slides`}>
									{b.items.map((it, k) => (
										<figure class:list={['cell-flex', 'slide', { on: k === 0 }]} aria-hidden={k !== 0}>
											<Media block={it} alt={(it as any).caption ?? `${title}, slide ${k + 1}`} sizes="(max-width: 800px) 100vw, 90vw" />
											{(it as any).caption && <figcaption class="hover-cap">{(it as any).caption}</figcaption>}
										</figure>
									))}
								</div>
								<div class="ctl">
									<button type="button" class="prev" aria-label="Previous slide">←</button>
									<span class="count"><span class="cur">1</span> / {b.items.length}</span>
									<button type="button" class="next" aria-label="Next slide">→</button>
								</div>
							</div>
						);
					}
					// Mixed shapes: justified rows like the old site — every row fills the width at one
					// height, nothing cropped, at most `cols` pictures per row (the old site's setting)
					const mixed = ratios[ratios.length - 1] / ratios[0] > 1.08;
					const perRow = (b as any).cols ?? parseInt(cls.replace('grid', ''), 10) ?? 3;
					if (/^grid\d$/.test(cls) && !plates && mixed && perRow > 0) {
						const rowsOf: typeof b.items[] = [];
						for (let k = 0; k < b.items.length; k += perRow) rowsOf.push(b.items.slice(k, k + perRow));
						return (
							<div class="block gallery reveal justified">
								{rowsOf.map((r) => (
									<div class="jrow">
										{r.map((it) => (
											<figure class="cell-flex" style={`flex: ${(it.width / it.height).toFixed(4)} 1 0%; aspect-ratio: ${it.width} / ${it.height}`}>
												<Media block={it} alt={(it as any).caption ?? title} sizes={`(max-width: 800px) 100vw, ${Math.round(100 / r.length)}vw`} />
												{(it as any).caption && <figcaption class="hover-cap">{(it as any).caption}</figcaption>}
											</figure>
										))}
									</div>
								))}
							</div>
						);
					}
					return (
						<div class:list={['block', 'gallery', 'reveal', cls, { plates }]} style={cls !== 'flow' ? `--ar: ${ar.toFixed(4)}` : undefined}>
							{b.items.map((it) => (
								<figure class="cell-flex" style={cls === 'flow' ? `flex: ${it.width / it.height}` : undefined}>
									<Media block={it} alt={(it as any).caption ?? title} sizes={cls === 'stack' ? '100vw' : /^grid\d$/.test(cls) ? `(max-width: 800px) 50vw, ${Math.round(100 / parseInt(cls.slice(4), 10))}vw` : '(max-width: 800px) 100vw, 40vw'} />
									{(it as any).caption && <figcaption class="hover-cap">{(it as any).caption}</figcaption>}
								</figure>
							))}
						</div>
					);
				}
				case 'row': {
					const media = b.columns.flatMap((c) => c.blocks);
					const photos = media.length > 0 && media.every((m) => m.type === 'image' || m.type === 'loop' || m.type === 'video' || m.type === 'gallery');
					// All-picture rows: size the columns from their pictures' shapes so every column
					// ends on the same bottom edge (a column of two diagrams beside one photo, etc.)
					const dims = (m: any): number | null => {
						if (m.type === 'gallery') {
							// a stacked gallery behaves like one tall picture
							if (m.layout !== 'stack' || !m.items.every((it: any) => it.width && it.height)) return null;
							return 1 / m.items.reduce((sum: number, it: any) => sum + it.height / it.width, 0);
						}
						return m.width && m.height ? m.width / m.height : null;
					};
					const fit = photos && b.columns.length >= 2 && b.columns.every((c) => c.blocks.every((m) => dims(m)));
					const colFlex = (c: any) => (fit ? 1 / c.blocks.reduce((sum: number, m: any) => sum + 1 / dims(m)!, 0) : c.flex);
					return (
						<div
							class:list={['block', 'row', { media: photos, fit, stagger: photos && b.columns.length === 2 && b.layout === 'stagger', spread: b.layout === 'spread' }]}
							style={fit ? `--cols: ${b.columns.map((c) => `${colFlex(c).toFixed(4)}fr`).join(' ')}` : undefined}
						>
							{b.columns.map((c, k) => (
								<div class="col" style={`flex: ${colFlex(c)} 1 0%; --c: ${k + 1}`}>
									<Astro.self blocks={c.blocks} title={title} nested />
								</div>
							))}
						</div>
					);
				}
			}
		})
	) : (
		<div class="mag">
			{cells.map((c) => (
				<div class:list={['cell', c.cls, { fit: !!c.fitH }]} style={cellStyle(c)}>
					<Astro.self blocks={c.blocks} title={title} nested />
				</div>
			))}
		</div>
	)
}

<script>
	// Play looping clips only while they are on screen
	document.addEventListener('astro:page-load', () => {
	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				const v = e.target as HTMLVideoElement;
				if (e.isIntersecting) v.play().catch(() => {});
				else v.pause();
			}
		},
		{ rootMargin: '200px 0px' },
	);
	document.querySelectorAll<HTMLVideoElement>('video[loop]').forEach((v) => io.observe(v));

	// Carousels: one timer each; a tick only advances while the carousel is on screen and
	// not under the cursor. Arrows or a click on the slide step manually and restart the countdown.
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const stops: (() => void)[] = [];
	document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
		const slides = Array.from(c.querySelectorAll<HTMLElement>('.slide'));
		const cur = c.querySelector('.cur')!;
		const every = Number(c.dataset.interval) || 4000;
		let i = 0, timer = 0, visible = false;
		const go = (n: number) => {
			slides[i].classList.remove('on');
			slides[i].setAttribute('aria-hidden', 'true');
			i = (n + slides.length) % slides.length;
			slides[i].classList.add('on');
			slides[i].removeAttribute('aria-hidden');
			cur.textContent = String(i + 1);
		};
		const restart = () => {
			clearInterval(timer);
			if (!reduce) timer = window.setInterval(() => { if (visible && !c.matches(':hover')) go(i + 1); }, every);
		};
		c.querySelector('.next')!.addEventListener('click', () => { go(i + 1); restart(); });
		c.querySelector('.prev')!.addEventListener('click', () => { go(i - 1); restart(); });
		c.querySelector('.slides')!.addEventListener('click', () => { go(i + 1); restart(); });
		new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.3 }).observe(c);
		restart();
		stops.push(() => clearInterval(timer));
	});
	document.addEventListener('astro:before-swap', () => stops.forEach((s) => s()), { once: true });
	});
</script>

<style>
	/* ---------- magazine grid (top level) ---------- */
	.mag {
		--gap: clamp(12px, 1.6vw, 24px);
		--pair-gap: clamp(32px, 4vw, 64px);
		container-type: inline-size;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(12px, 1.6vw, 24px);
		row-gap: clamp(36px, 4.5vw, 72px);
		align-items: start;
	}
	.cell {
		min-width: 0;
	}
	/* Text opens what follows: more air above it, less between it and its pictures */
	.cell.intro,
	.cell.text-l,
	.cell.text-r,
	.cell.quote,
	.cell.credits {
		padding-top: clamp(8px, 2vw, 32px);
	}
	.cell.intro .text :global(h2),
	.cell.intro .text :global(h3) {
		margin-bottom: 0.45em;
	}
	.full { grid-column: 1 / -1; }
	.wide-l { grid-column: 1 / 9; }
	.wide-r { grid-column: 5 / 13; }
	.half-l { grid-column: 1 / 7; }
	.half-r { grid-column: 7 / 13; }
	.narrow-l { grid-column: 1 / 6; }
	.narrow-r { grid-column: 8 / 13; }
	.third-l { grid-column: 2 / 6; }
	.third-r { grid-column: 8 / 12; }
	.small-l { grid-column: 1 / 5; }
	.small-c { grid-column: 5 / 9; }
	.small-r { grid-column: 9 / 13; }
	.wide-c { grid-column: 3 / 11; }
	.narrow-c { grid-column: 4 / 10; }
	.tri-a { grid-column: 1 / 5; }
	.tri-b { grid-column: 5 / 9; }
	.tri-c { grid-column: 9 / 13; }
	.text-l { grid-column: 1 / 6; }
	.text-r { grid-column: 8 / 13; }
	.intro { grid-column: 1 / 9; }
	.intro .text { max-width: 40rem; }
	.beside-l { grid-column: 1 / 5; }
	.beside-r { grid-column: 9 / 13; }
	.low { align-self: end; }
	.cell.fit :global(.media) {
		width: 100%;
		height: var(--fit-h);
		max-height: none;
		object-fit: cover;
	}
