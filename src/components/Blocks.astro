---
/**
 * Renders a case study's blocks.
 *
 * Top level: lays the blocks out on a 12-column magazine grid — images take one, two
 * or all columns and alternate sides, consecutive images are paired and staggered,
 * text sits in a narrow measure opposite the last image, and heading-only blocks
 * become pull quotes. Nested (inside a row column): plain linear rendering.
 */
import Media from './Media.astro';
import type { Block, MediaBlock } from '../data/case-studies';

interface Props {
	blocks: Block[];
	title: string;
	nested?: boolean;
}

const { blocks, title, nested = false } = Astro.props;

const isImg = (b: Block): b is MediaBlock => b.type === 'image' || b.type === 'loop';
const ratio = (b: MediaBlock) => b.width / b.height;
const landscape = (b: MediaBlock) => ratio(b) >= 1.25;
const portrait = (b: MediaBlock) => ratio(b) < 0.9;
const isStatement = (html: string) => /<h[23]>/.test(html) && !/<p>|<ul>|<ol>/.test(html);
const allImages = (bs: Block[]) => bs.length > 0 && bs.every(isImg);

interface Cell {
	cls: string;
	blocks: Block[];
}

function layout(bs: Block[]): Cell[] {
	const cells: Cell[] = [];
	let side: 'l' | 'r' = 'r'; // where the next non-full item goes
	let singles = 0;
	const flip = () => (side = side === 'l' ? 'r' : 'l');

	for (let i = 0; i < bs.length; i++) {
		const b = bs[i];
		const next = bs[i + 1];

		if (b.type === 'text') {
			if (isStatement(b.html)) {
				// Short headings ("Part I: AIncense") are section labels; longer ones read as pull quotes
				const words = b.html.replace(/<[^>]+>/g, ' ').trim();
				cells.push({ cls: words.length < 36 ? 'section' : 'quote', blocks: [b] });
			} else {
				cells.push({ cls: `text-${side}`, blocks: [b] });
				flip();
			}
			continue;
		}

		if (isImg(b) && next && isImg(next)) {
			// Two images in a row: put them side by side, second one dropped down a little
			const [a, c] = [b, next];
			if (landscape(a) && landscape(c)) {
				cells.push({ cls: 'half-l', blocks: [a] }, { cls: 'half-r stagger', blocks: [c] });
			} else if (portrait(a) && portrait(c)) {
				cells.push({ cls: 'third-l', blocks: [a] }, { cls: 'third-r stagger', blocks: [c] });
			} else if (portrait(c)) {
				cells.push({ cls: 'wide-l', blocks: [a] }, { cls: 'narrow-r stagger', blocks: [c] });
			} else {
				cells.push({ cls: 'narrow-l', blocks: [a] }, { cls: 'wide-r stagger', blocks: [c] });
			}
			i++;
			side = 'l';
			continue;
		}

		if (isImg(b)) {
			if (portrait(b)) {
				cells.push({ cls: `narrow-${side}`, blocks: [b] });
				flip();
			} else if (landscape(b)) {
				// Every other lone landscape image goes full width
				if (singles % 2 === 0) cells.push({ cls: 'full', blocks: [b] });
				else {
					cells.push({ cls: `wide-${side}`, blocks: [b] });
					flip();
				}
				singles++;
			} else {
				cells.push({ cls: `half-${side}`, blocks: [b] });
				flip();
			}
			continue;
		}

		// video, youtube, gallery, row
		cells.push({ cls: 'full', blocks: [b] });
	}
	return cells;
}

const cells = nested ? [] : layout(blocks);
---

{
	nested ? (
		blocks.map((b) => {
			switch (b.type) {
				case 'text':
					return <div class="block text" set:html={b.html} />;
				case 'image':
					return (
						<figure class="block media-block">
							<Media block={b} alt={b.caption ?? title} sizes="(max-width: 800px) 100vw, 60vw" />
							{b.caption && <figcaption set:html={b.caption} />}
						</figure>
					);
				case 'loop':
				case 'video':
					return (
						<figure class="block media-block">
							<Media block={b} sizes="(max-width: 800px) 100vw, 60vw" />
						</figure>
					);
				case 'youtube':
					return (
						<div class="block embed">
							<iframe
								src={`https://www.youtube-nocookie.com/embed/${b.id}`}
								title={`${title} video`}
								loading="lazy"
								allow="autoplay; picture-in-picture; fullscreen"
								allowfullscreen
							/>
						</div>
					);
				case 'gallery':
					return (
						<div class="block gallery">
							{b.items.map((it) => (
								<div class="cell-flex" style={`flex: ${it.width / it.height}`}>
									<Media block={it} alt={title} sizes="(max-width: 800px) 100vw, 40vw" />
								</div>
							))}
						</div>
					);
				case 'row':
					return (
						<div class:list={['block', 'row', { stagger: b.columns.length === 2 && b.columns.every((c) => allImages(c.blocks)) }]}>
							{b.columns.map((c) => (
								<div class="col" style={`flex: ${c.flex}`}>
									<Astro.self blocks={c.blocks} title={title} nested />
								</div>
							))}
						</div>
					);
			}
		})
	) : (
		<div class="mag">
			{cells.map((c) => (
				<div class:list={['cell', c.cls]}>
					<Astro.self blocks={c.blocks} title={title} nested />
				</div>
			))}
		</div>
	)
}

<script>
	// Play looping clips only while they are on screen
	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				const v = e.target as HTMLVideoElement;
				if (e.isIntersecting) v.play().catch(() => {});
				else v.pause();
			}
		},
		{ rootMargin: '200px 0px' },
	);
	document.querySelectorAll<HTMLVideoElement>('video[loop]').forEach((v) => io.observe(v));
</script>

<style>
	/* ---------- magazine grid (top level) ---------- */
	.mag {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(12px, 1.6vw, 24px);
		row-gap: clamp(48px, 7vw, 120px);
		align-items: start;
	}
	.cell {
		min-width: 0;
	}
	.full {
		grid-column: 1 / -1;
	}
	.wide-l {
		grid-column: 1 / 9;
	}
	.wide-r {
		grid-column: 5 / 13;
	}
	.half-l {
		grid-column: 1 / 7;
	}
	.half-r {
		grid-column: 7 / 13;
	}
	.narrow-l {
		grid-column: 1 / 6;
	}
	.narrow-r {
		grid-column: 8 / 13;
	}
	.third-l {
		grid-column: 2 / 6;
	}
	.third-r {
		grid-column: 8 / 12;
	}
	.text-l {
		grid-column: 1 / 6;
	}
	.text-r {
		grid-column: 8 / 13;
	}
	.quote {
		grid-column: 2 / 12;
	}
	.section {
		grid-column: 1 / -1;
		padding-top: 14px;
		border-top: 1px solid var(--line);
		margin-bottom: calc(-1 * clamp(24px, 4vw, 72px));
	}
	.section .text :global(h2),
	.section .text :global(h3) {
		font: 500 12px/1.4 var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 0;
	}
	.stagger {
		margin-top: clamp(32px, 7vw, 120px);
	}
	.cell > :global(.block:last-child) {
		margin-bottom: 0;
	}

	/* ---------- blocks ---------- */
	.block {
		margin-block: 0 clamp(24px, 3vw, 40px);
	}
	.media-block {
		margin-inline: 0;
	}
	figcaption {
		font: 11px/1.5 var(--mono);
		color: var(--muted);
		margin-top: 10px;
		letter-spacing: 0.02em;
	}
	.text :global(h2) {
		font-size: clamp(24px, 2.4vw, 34px);
		line-height: 1.12;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 0.7em;
	}
	.text :global(h2 strong) {
		font-weight: inherit;
	}
	.text :global(h3) {
		font-size: clamp(17px, 1.4vw, 20px);
		line-height: 1.3;
		font-weight: 600;
		margin: 1.4em 0 0.5em;
	}
	.text :global(h3:first-child),
	.text :global(h2:first-child) {
		margin-top: 0;
	}
	.text :global(p),
	.text :global(li) {
		font-size: 15px;
		line-height: 1.65;
		margin: 0 0 1em;
	}
	.text :global(p:last-child) {
		margin-bottom: 0;
	}
	.text :global(p.caption) {
		font: 11px/1.5 var(--mono);
		color: var(--muted);
	}
	.text :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	/* Heading-only blocks read as pull quotes */
	.quote .text :global(h2),
	.quote .text :global(h3) {
		font-size: clamp(24px, 3.2vw, 44px);
		line-height: 1.12;
		font-weight: 500;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}
	.embed {
		position: relative;
		aspect-ratio: 16 / 9;
		max-width: 100%;
	}
	.embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
	.gallery,
	.row {
		display: flex;
		gap: clamp(8px, 1.5vw, 20px);
		align-items: flex-start;
	}
	.row {
		gap: clamp(16px, 3vw, 48px);
		align-items: center;
	}
	.row.stagger {
		margin-top: 0;
		align-items: flex-start;
	}
	.row.stagger .col:nth-child(2) {
		margin-top: clamp(32px, 7vw, 120px);
	}
	.col,
	.cell-flex {
		min-width: 0;
	}
	.col > :global(.block:last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 800px) {
		.mag {
			row-gap: 40px;
		}
		.mag > .cell {
			grid-column: 1 / -1;
		}
		.stagger,
		.row.stagger .col:nth-child(2) {
			margin-top: 0;
		}
		.row {
			flex-direction: column;
			align-items: stretch;
		}
		.row .col {
			flex: none !important;
		}
		.gallery {
			flex-wrap: wrap;
		}
		.gallery .cell-flex {
			flex-basis: 100% !important;
		}
		.col > :global(.block:last-child) {
			margin-bottom: clamp(24px, 3vw, 40px);
		}
	}
</style>
