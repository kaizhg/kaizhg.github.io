---
/**
 * Renders a case study's blocks.
 *
 * Top level: a 12-column magazine grid. Each block may carry a `layout` (assigned by
 * scripts/plan-layout.py, by eye per project); blocks without one fall back to simple
 * rules — images alternate sides and pair up, text sits in a narrow measure, headings
 * become section labels or pull quotes. Cells are placed in order; a left cell followed
 * by a right cell shares its row (text-l + half-r, wide-l + beside-r). A layout ending in
 * ' pull' is rendered before the previous cell, so text can sit beside the image that
 * precedes it in the story.
 *
 * Nested (inside a row column): plain linear rendering.
 */
import Media from './Media.astro';
import type { Block, MediaBlock } from '../data/case-studies';

interface Props {
	blocks: Block[];
	title: string;
	nested?: boolean;
}

const { blocks, title, nested = false } = Astro.props;

type Laid = Block & { layout?: string; kind?: string };
const isImg = (b: Block): b is MediaBlock => b.type === 'image' || b.type === 'loop';
const ratio = (b: MediaBlock) => b.width / b.height;
const landscape = (b: MediaBlock) => ratio(b) >= 1.25;
const portrait = (b: MediaBlock) => ratio(b) < 0.9;

interface Cell {
	cls: string;
	blocks: Block[];
}

// Text that may sit beside an image: unplanned, or planned as a plain side column
const plainText = (b?: Laid) =>
	!!b && b.type === 'text' && (!b.layout || /^text-[lr]$/.test(b.layout)) && (b.kind === 'text' || !b.kind) &&
	!/<h[23]>/.test(b.html) && b.html.replace(/<[^>]+>/g, '').length < 900;
const sideOf = (cls?: string) => (cls && /-l\b/.test(cls) ? 'l' : cls && /-r\b/.test(cls) ? 'r' : null);
// Text cell that shares the row with an image cell of the given class, bottom-aligned
const BESIDE: Record<string, [string, 'before' | 'after']> = {
	'wide-r': ['pair-before-wide', 'before'],
	'half-r': ['pair-before-half', 'before'],
	'narrow-r': ['pair-before-narrow', 'before'],
	'third-r': ['pair-before-narrow', 'before'],
	'wide-l': ['pair-after-wide', 'after'],
	'half-l': ['pair-after-half', 'after'],
	'narrow-l': ['pair-after-narrow', 'after'],
	'third-l': ['pair-after-narrow', 'after'],
};

function layout(bs: Laid[]): Cell[] {
	const cells: Cell[] = [];
	let side: 'l' | 'r' = 'r';
	let singles = 0;
	const flip = () => (side = side === 'l' ? 'r' : 'l');

	for (let i = 0; i < bs.length; i++) {
		const b = bs[i];
		const next = bs[i + 1];

		// Push a media cell; if plain text follows and there is room beside the image,
		// the text joins the same row, aligned to the image's bottom edge (magazine style)
		const pushMedia = (cls: string) => {
			const beside = BESIDE[cls.replace(/ stagger$/, '')];
			if (beside && plainText(next)) {
				const [tcls, where] = beside;
				if (where === 'before') cells.push({ cls: tcls, blocks: [next] }, { cls, blocks: [b] });
				else cells.push({ cls, blocks: [b] }, { cls: tcls, blocks: [next] });
				i++;
			} else cells.push({ cls, blocks: [b] });
			if (/-l\b/.test(cls)) side = 'r';
			else if (/-r\b/.test(cls)) side = 'l';
		};

		// Explicit decision from the plan (gallery/row layouts are handled inside the block)
		if (b.layout && b.type !== 'gallery' && b.type !== 'row') {
			if (b.layout === 'skip') continue;
			if (/ pull$/.test(b.layout)) cells.splice(cells.length - 1, 0, { cls: b.layout.replace(/ pull$/, ''), blocks: [b] });
			else if (b.type === 'text') {
				// A planned side text followed by a planned image on the other side: pair them on one row
				const nb = next?.layout?.replace(/ stagger$/, '');
				if (/^text-[lr]$/.test(b.layout) && next && nb && BESIDE[nb] && sideOf(nb) !== sideOf(b.layout)) {
					const [tcls, where] = BESIDE[nb];
					if (where === 'before') cells.push({ cls: tcls, blocks: [b] }, { cls: next.layout!, blocks: [next] });
					else cells.push({ cls: next.layout!, blocks: [next] }, { cls: tcls, blocks: [b] });
					i++;
					side = sideOf(nb) === 'l' ? 'r' : 'l';
					continue;
				}
				cells.push({ cls: b.layout, blocks: [b] });
			} else pushMedia(b.layout);
			if (/-l\b/.test(b.layout)) side = 'r';
			else if (/-r\b/.test(b.layout)) side = 'l';
			continue;
		}

		// A staggered pair of photos followed by text: the text tucks under the first photo
		if (b.type === 'row' && plainText(next)) {
			const media = b.columns.flatMap((c) => c.blocks);
			const photos = media.length > 0 && media.every((m) => m.type === 'image' || m.type === 'loop' || m.type === 'video' || m.type === 'gallery');
			if (photos && b.columns.length === 2 && b.layout !== 'flat') {
				const merged = { ...b, columns: [{ ...b.columns[0], blocks: [...b.columns[0].blocks, next!] }, b.columns[1]] };
				cells.push({ cls: 'full', blocks: [merged] });
				i++;
				continue;
			}
		}

		if (b.type === 'text') {
			if (b.kind === 'credits') cells.push({ cls: 'credits', blocks: [b] });
			else if (b.kind === 'section') cells.push({ cls: 'section', blocks: [b] });
			else if (b.kind === 'quote') cells.push({ cls: 'quote', blocks: [b] });
			else if (/<h[23]>/.test(b.html)) cells.push({ cls: 'intro', blocks: [b] }); // a heading opens a section
			else cells.push({ cls: 'text-l', blocks: [b] });
			continue;
		}

		if (isImg(b) && next && isImg(next) && !next.layout) {
			const flat = b.kind === 'white' || next.kind === 'white' ? '' : ' stagger';
			if (landscape(b) && landscape(next)) {
				cells.push({ cls: 'half-l', blocks: [b] }, { cls: 'half-r' + flat, blocks: [next] });
			} else if (portrait(b) && portrait(next)) {
				cells.push({ cls: 'third-l', blocks: [b] }, { cls: 'third-r' + flat, blocks: [next] });
			} else if (portrait(next)) {
				cells.push({ cls: 'wide-l', blocks: [b] }, { cls: 'narrow-r' + flat, blocks: [next] });
			} else {
				cells.push({ cls: 'narrow-l', blocks: [b] }, { cls: 'wide-r' + flat, blocks: [next] });
			}
			i++;
			side = 'l';
			continue;
		}

		if (isImg(b)) {
			// Images anchor to the left edge; the text that explains them sits to their right
			if (b.kind === 'white') {
				pushMedia(landscape(b) ? 'wide-l' : 'half-l'); // diagrams never go full-bleed
			} else if (portrait(b)) {
				pushMedia('narrow-l');
			} else if (landscape(b)) {
				if (ratio(b) >= 1.6 && singles % 2 === 0) cells.push({ cls: 'full', blocks: [b] });
				else pushMedia('wide-l');
				singles++;
			} else {
				pushMedia('half-l');
			}
			continue;
		}

		cells.push({ cls: 'full', blocks: [b] });
	}
	return cells;
}

const cells = nested ? [] : layout(blocks as Laid[]);
const galleryClass = (b: Laid) => (b.layout && /^(grid\d|strip|stack)$/.test(b.layout) ? b.layout : 'flow');
---

{
	nested ? (
		(blocks as Laid[]).map((b) => {
			switch (b.type) {
				case 'text':
					return <div class:list={['block', 'text', { credits: b.kind === 'credits' }]} set:html={b.html} />;
				case 'image':
					return (
						<figure class="block media-block reveal">
							<Media block={b} alt={b.caption ?? title} sizes="(max-width: 800px) 100vw, 60vw" />
							{b.caption && <figcaption set:html={b.caption} />}
						</figure>
					);
				case 'loop':
				case 'video':
					return (
						<figure class="block media-block reveal">
							<Media block={b} sizes="(max-width: 800px) 100vw, 60vw" />
						</figure>
					);
				case 'youtube':
					return (
						<div class="block embed reveal">
							<iframe
								src={`https://www.youtube.com/embed/${b.id}${b.start ? `?start=${b.start}` : ''}`}
								title={`${title} video`}
								referrerpolicy="strict-origin-when-cross-origin"
								loading="lazy"
								allow="autoplay; picture-in-picture; fullscreen"
								allowfullscreen
							/>
						</div>
					);
				case 'gallery': {
					const cls = galleryClass(b);
					const ratios = b.items.map((it) => it.width / it.height).sort((a, c) => a - c);
					const ar = ratios[Math.floor(ratios.length / 2)];
					const plates = cls !== 'flow' && b.items.every((it) => (it as Laid).kind === 'white');
					return (
						<div class:list={['block', 'gallery', 'reveal', cls, { plates }]} style={cls !== 'flow' ? `--ar: ${ar.toFixed(4)}` : undefined}>
							{b.items.map((it) => (
								<figure class="cell-flex" style={cls === 'flow' ? `flex: ${it.width / it.height}` : undefined}>
									<Media block={it} alt={(it as any).caption ?? title} sizes="(max-width: 800px) 100vw, 40vw" />
									{(it as any).caption && <figcaption class="hover-cap">{(it as any).caption}</figcaption>}
								</figure>
							))}
						</div>
					);
				}
				case 'row': {
					const media = b.columns.flatMap((c) => c.blocks);
					const photos = media.length > 0 && media.every((m) => m.type === 'image' || m.type === 'loop' || m.type === 'video' || m.type === 'gallery');
					return (
						<div class:list={['block', 'row', { media: photos, stagger: photos && b.columns.length === 2 && b.layout === 'stagger' }]}>
							{b.columns.map((c) => (
								<div class="col" style={`flex: ${c.flex}`}>
									<Astro.self blocks={c.blocks} title={title} nested />
								</div>
							))}
						</div>
					);
				}
			}
		})
	) : (
		<div class="mag">
			{cells.map((c) => (
				<div class:list={['cell', c.cls]}>
					<Astro.self blocks={c.blocks} title={title} nested />
				</div>
			))}
		</div>
	)
}

<script>
	// Play looping clips only while they are on screen
	document.addEventListener('astro:page-load', () => {
	const io = new IntersectionObserver(
		(entries) => {
			for (const e of entries) {
				const v = e.target as HTMLVideoElement;
				if (e.isIntersecting) v.play().catch(() => {});
				else v.pause();
			}
		},
		{ rootMargin: '200px 0px' },
	);
	document.querySelectorAll<HTMLVideoElement>('video[loop]').forEach((v) => io.observe(v));
	});
</script>

<style>
	/* ---------- magazine grid (top level) ---------- */
	.mag {
		--pair-gap: clamp(32px, 4vw, 64px);
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: clamp(12px, 1.6vw, 24px);
		row-gap: clamp(36px, 4.5vw, 72px);
		align-items: start;
	}
	.cell {
		min-width: 0;
	}
	/* Text opens what follows: more air above it, less between it and its pictures */
	.cell.intro,
	.cell.text-l,
	.cell.text-r,
	.cell.quote,
	.cell.credits {
		padding-top: clamp(8px, 2vw, 32px);
	}
	.cell.intro .text :global(h2),
	.cell.intro .text :global(h3) {
		margin-bottom: 0.45em;
	}
	.full { grid-column: 1 / -1; }
	.wide-l { grid-column: 1 / 9; }
	.wide-r { grid-column: 5 / 13; }
	.half-l { grid-column: 1 / 7; }
	.half-r { grid-column: 7 / 13; }
	.narrow-l { grid-column: 1 / 6; }
	.narrow-r { grid-column: 8 / 13; }
	.third-l { grid-column: 2 / 6; }
	.third-r { grid-column: 8 / 12; }
	.small-l { grid-column: 1 / 5; }
	.small-c { grid-column: 5 / 9; }
	.small-r { grid-column: 9 / 13; }
	.wide-c { grid-column: 3 / 11; }
	.narrow-c { grid-column: 4 / 10; }
	.tri-a { grid-column: 1 / 5; }
	.tri-b { grid-column: 5 / 9; }
	.tri-c { grid-column: 9 / 13; }
	.text-l { grid-column: 1 / 6; }
	.text-r { grid-column: 8 / 13; }
	.intro { grid-column: 1 / 9; }
	.intro .text { max-width: 40rem; }
	.beside-l { grid-column: 1 / 5; }
	.beside-r { grid-column: 9 / 13; }
	.low { align-self: end; }
	/* Auto-paired text: directly beside its image, one consistent gap, a readable measure */
	.pair-after-wide { grid-column: 9 / 13; }
	.pair-after-half { grid-column: 7 / 13; }
	.pair-after-narrow { grid-column: 6 / 13; }
	.pair-before-wide { grid-column: 1 / 5; }
	.pair-before-half { grid-column: 1 / 7; }
	.pair-before-narrow { grid-column: 1 / 8; }
	[class*='pair-after'] { padding-left: calc(var(--pair-gap) - clamp(12px, 1.6vw, 24px)); }
	[class*='pair-before'] { padding-right: calc(var(--pair-gap) - clamp(12px, 1.6vw, 24px)); }
	[class*='pair-'] .text { max-width: 30rem; }
	.credits { grid-column: 1 / 5; }
	.quote { grid-column: 2 / 12; }
	.section {
		grid-column: 1 / -1;
		padding-top: 14px;
		border-top: 1px solid var(--line);
		margin-bottom: calc(-1 * clamp(24px, 4vw, 72px));
	}
	.section .text :global(h2),
	.section .text :global(h3) {
		font: 500 12px/1.4 var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		margin: 0;
	}
	.stagger {
		margin-top: clamp(32px, 7vw, 120px);
	}
	.cell > :global(.block:last-child) {
		margin-bottom: 0;
	}

	/* ---------- blocks ---------- */
	.block {
		margin-block: 0 clamp(24px, 3vw, 40px);
	}
	.media-block {
		margin-inline: 0;
	}
	figcaption {
		font: 11px/1.5 var(--mono);
		color: var(--muted);
		margin-top: 10px;
		letter-spacing: 0.02em;
	}
	.text :global(h2) {
		font-size: clamp(24px, 2.4vw, 34px);
		line-height: 1.12;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 0.7em;
	}
	.text :global(h2 strong) {
		font-weight: inherit;
	}
	.text :global(h3) {
		font-size: clamp(17px, 1.4vw, 20px);
		line-height: 1.3;
		font-weight: 600;
		margin: 1.4em 0 0.5em;
	}
	.text :global(h3:first-child),
	.text :global(h2:first-child) {
		margin-top: 0;
	}
	.text :global(p),
	.text :global(li) {
		font-family: var(--text);
		font-size: 15px;
		line-height: 1.65;
		margin: 0 0 1em;
	}
	.text :global(p:last-child) {
		margin-bottom: 0;
	}
	.text :global(p.caption) {
		font: 11px/1.5 var(--mono);
		color: var(--muted);
	}
	.text :global(a) {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	/* Credits (course, team, role) read as a small mono colophon */
	.text.credits :global(p),
	.text.credits :global(h3) {
		font: 13px/1.6 var(--text);
		color: var(--muted);
		margin: 0;
	}
	.quote .text :global(h2),
	.quote .text :global(h3),
	.quote .text :global(p) {
		font-size: clamp(24px, 3.2vw, 44px);
		line-height: 1.12;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}
	.embed {
		position: relative;
		aspect-ratio: 16 / 9;
		max-width: 100%;
	}
	.embed iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* Galleries: 'flow' sizes by aspect ratio; gridN / strip are equal cells */
	.gallery,
	.row {
		display: flex;
		gap: clamp(12px, 1.6vw, 24px);
		align-items: flex-start;
	}
	.gallery.strip .cell-flex {
		flex: 1;
	}
	.gallery.grid2,
	.gallery.grid3,
	.gallery.grid4,
	.gallery.grid5 {
		display: grid;
		gap: clamp(12px, 1.6vw, 24px);
	}
	.gallery.stack { display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(12px, 1.6vw, 24px); }
	.gallery.grid2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.gallery.grid3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.gallery.grid4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	.gallery.grid5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }
	/* Everything in a row shares its top edge */
	.row {
		gap: var(--pair-gap);
		align-items: flex-start;
	}
	.row.media,
	.row.stagger {
		align-items: flex-start;
		gap: clamp(12px, 1.6vw, 24px);
	}
	.row.stagger .col:nth-child(2) {
		margin-top: clamp(32px, 7vw, 120px);
	}
	.col,
	.cell-flex {
		min-width: 0;
	}
	.cell-flex {
		margin: 0;
		position: relative;
	}
	/* Equal plates: every diagram in a grid sits in the same frame, whatever its own padding */
	.gallery.grid2 .cell-flex,
	.gallery.grid3 .cell-flex,
	.gallery.grid4 .cell-flex,
	.gallery.grid5 .cell-flex,
	.gallery.stack .cell-flex {
		aspect-ratio: var(--ar, 4 / 3);
		overflow: hidden;
	}
	.gallery.plates .cell-flex {
		background: #fff;
	}
	.gallery.grid2 .cell-flex :global(.media),
	.gallery.grid3 .cell-flex :global(.media),
	.gallery.grid4 .cell-flex :global(.media),
	.gallery.grid5 .cell-flex :global(.media),
	.gallery.stack .cell-flex :global(.media) {
		width: 100%;
		height: 100%;
		max-height: none;
		object-fit: cover;
		background: transparent;
	}
	.gallery.plates .cell-flex :global(.media) {
		object-fit: contain;
	}
	/* Captions from the old site: appear on hover, always shown on touch screens */
	.hover-cap {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		margin: 0;
		padding: 24px 10px 8px;
		font: 11px/1.4 var(--mono);
		letter-spacing: 0.02em;
		color: #fff;
		background: linear-gradient(to top, rgb(0 0 0 / 0.55), rgb(0 0 0 / 0));
		opacity: 0;
		transition: opacity 0.25s ease;
		pointer-events: none;
	}
	.cell-flex:hover .hover-cap {
		opacity: 1;
	}
	@media (hover: none) {
		.hover-cap {
			opacity: 1;
		}
	}
	.col > :global(.block:last-child) {
		margin-bottom: 0;
	}

	@media (max-width: 800px) {
		.mag {
			row-gap: 40px;
		}
		[class*='pair-after'],
		[class*='pair-before'] {
			padding: 0;
		}
		.mag > .cell {
			grid-column: 1 / -1;
		}
		.stagger,
		.row.stagger .col:nth-child(2) {
			margin-top: 0;
		}
		.row {
			flex-direction: column;
			align-items: stretch;
		}
		.row .col {
			flex: none !important;
		}
		.gallery.flow,
		.gallery.strip {
			flex-wrap: wrap;
		}
		.gallery.flow .cell-flex,
		.gallery.strip .cell-flex {
			flex-basis: 100% !important;
		}
		.gallery.grid4,
		.gallery.grid5 {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.col > :global(.block:last-child) {
			margin-bottom: clamp(24px, 3vw, 40px);
		}
	}
</style>
