---
/** The list view: one row per project, hero shot rising above the row on hover. */
import { getImage } from 'astro:assets';
import { projectCode, type Project } from '../data/projects';
import { getCaseStudy, workImage } from '../data/case-studies';

interface Props {
	items: Project[];
	/** Where the "Grid view" switch leads. */
	gridHref: string;
	label?: string;
}
const { items, gridHref, label = 'Projects' } = Astro.props;

// The same cover the grid tile shows (a still, or the looping clip)
const previews: Record<string, { type: 'image' | 'loop'; src: string; lqip?: string } | null> = Object.fromEntries(
	await Promise.all(
		items.map(async (p) => {
			const s = getCaseStudy(p.slug);
			const cover = s?.cover ?? s?.hero;
			if (!cover) return [p.slug, null];
			if (cover.type === 'loop') return [p.slug, { type: 'loop', src: cover.src, lqip: cover.lqip }];
			if (cover.type !== 'image') return [p.slug, null];
			const img = await getImage({ src: workImage(cover.src), width: 960, format: 'webp' });
			return [p.slug, { type: 'image', src: img.src, lqip: cover.lqip }];
		}),
	),
);
---

<section class="index" aria-label={label}>
	<div class="bar">
		<a class="switch" href={gridHref}>Grid view →</a>
	</div>

	<ol class="list">
		{
			items.map((p) => (
				<li>
					<a href={`/work/${p.slug}/`}>
						<span class="code">{projectCode(p)}</span>
						<span class="title">{p.title}</span>
						<span class="summary">
							{p.summary}
							{p.context && <span class="context"> @ {p.context}</span>}
						</span>
						<span class="slot" aria-hidden="true">
							{previews[p.slug]?.type === 'image' && (
								<span class="thumb" style={previews[p.slug]!.lqip ? `background-image: url(${previews[p.slug]!.lqip})` : undefined}>
									<img src={previews[p.slug]!.src} alt="" decoding="async" fetchpriority="low" />
								</span>
							)}
							{previews[p.slug]?.type === 'loop' && (
								<span class="thumb">
									<video src={previews[p.slug]!.src} muted loop playsinline autoplay preload="metadata" />
								</span>
							)}
						</span>
						<span class="arrow" aria-hidden="true">→</span>
					</a>
				</li>
			))
		}
	</ol>
</section>

<style>
	.bar {
		display: flex;
		justify-content: flex-end;
		align-items: center;
		gap: 16px;
		flex-wrap: wrap;
		margin-bottom: 16px;
	}
	.switch {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
	}
	.switch:hover {
		color: var(--fg);
	}
	.list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}
	.list a {
		--row-pad: 14px;
		display: grid;
		/* code | title | summary | empty slot reserved for the hover shot | arrow */
		grid-template-columns: 5rem minmax(14rem, 1fr) 1.2fr clamp(260px, 42%, 820px) auto;
		gap: 1rem;
		align-items: baseline;
		padding: var(--row-pad) 12px;
		margin-inline: -12px;
		border-bottom: 1px solid var(--line);
		/* Row highlight: fills in fast, fades out slowly (like zarki.net) */
		transition: background-color 0.5s ease, color 0.5s ease;
	}
	.code {
		font: 11px var(--mono);
		letter-spacing: 0.04em;
		color: var(--muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.title {
		font-size: 18px;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}
	.summary {
		color: var(--muted);
		font-size: 14px;
	}
	.arrow {
		transition: transform 0.2s ease;
	}
	.code,
	.summary {
		transition: color 0.5s ease;
	}

	/* Hero shot: fills the empty slot column, grows upward from the row's bottom edge.
	   Its height follows the column width (32:25, the cover ratio) so it scales with the screen. */
	.slot {
		position: relative;
		align-self: stretch;
		container-type: inline-size;
	}
	.thumb {
		position: absolute;
		left: 0;
		right: 0;
		bottom: calc(-1 * var(--row-pad));
		height: 0;
		overflow: hidden;
		background-size: cover;
		background-position: center;
		pointer-events: none;
		transition: height 0.25s cubic-bezier(0.4, 0, 0.6, 1);
	}
	.thumb img,
	.thumb video {
		position: absolute;
		left: 0;
		top: 50%;
		width: 100%;
		height: 78.125cqw;
		object-fit: cover;
		transform: translateY(-50%);
		background: var(--line);
	}

	.list a:hover,
	.list a:focus-visible {
		background-color: var(--fg);
		color: var(--bg);
		outline: none;
		transition-duration: 0.2s;
	}
	.list a:hover .code,
	.list a:hover .summary,
	.list a:focus-visible .code,
	.list a:focus-visible .summary {
		color: var(--bg);
		opacity: 0.7;
		transition-duration: 0.2s;
	}
	.list a:hover .arrow,
	.list a:focus-visible .arrow {
		transform: translateX(4px);
	}
	.list a:hover .thumb,
	.list a:focus-visible .thumb {
		height: 78.125cqw;
		transition: height 0.2s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	@media (prefers-reduced-motion: reduce) {
		.list a,
		.thumb,
		.list a:hover .thumb {
			transition-duration: 0.01s;
		}
	}
	@media (hover: none) {
		.thumb {
			display: none;
		}
	}
	/* Narrower screens: drop the summary, keep code | title | shot | arrow */
	@media (max-width: 1100px) {
		.list a {
			grid-template-columns: 5rem minmax(0, 1fr) clamp(220px, 42%, 480px) auto;
		}
		.summary {
			display: none;
		}
	}
	@media (max-width: 720px) {
		.list a {
			grid-template-columns: 4.5rem minmax(0, 1fr) auto;
			gap: 1rem;
		}
		.slot {
			display: none;
		}
	}
</style>
