---
import { Image } from 'astro:assets';
import { workImage, type MediaBlock } from '../data/case-studies';

interface Props {
	block: MediaBlock;
	alt?: string;
	sizes?: string;
	eager?: boolean;
	portrait?: boolean;
}

const { block, alt = '', sizes = '(max-width: 1400px) 100vw, 1400px', eager = false, portrait = false } = Astro.props;
---

{
	block.type === 'image' && (
		<Image
			src={workImage(block.src)}
			alt={alt}
			widths={[...new Set([640, 1024, 1600, 2400, block.width].filter((w) => w <= block.width))]}
			sizes={sizes}
			loading={eager ? 'eager' : 'lazy'}
			class:list={['media', { alpha: /\.png$/i.test(block.src), ink: block.ink, portrait }]}
			style={[block.maxWidth ? `max-width: ${block.maxWidth}px` : '', block.lqip ? `background-image: url(${block.lqip})` : ''].filter(Boolean).join('; ') || undefined}
			data-fade={block.lqip ? '' : undefined}
		/>
	)
}
{
	block.type === 'loop' && (
		<video
			class="media"
			src={block.src}
			poster={block.poster}
			width={block.width}
			height={block.height}
			style={block.lqip ? `background-image: url(${block.lqip})` : undefined}
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
		/>
	)
}
{
	block.type === 'video' && (
		<video
			class="media"
			src={block.src}
			poster={block.poster}
			width={block.width}
			height={block.height}
			controls
			playsinline
			preload="none"
		/>
	)
}

<style>
	/* Never taller than a screen: shrink to fit and keep the left edge */
	.media {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 82vh;
		background: var(--line); /* placeholder tint while a photo loads */
	}
	/* Cut-outs (PNG with transparency) sit straight on the page, no tint behind them */
	.media.alpha {
		background: transparent;
	}
	/* Black line art (logos, diagrams) reads as white on the dark theme */
	@media (prefers-color-scheme: dark) {
		.media.ink {
			filter: invert(1);
		}
	}
	/* A blurred 24px stand-in sits behind the picture (inline background-image) and the real
	   file focuses in over it: blurred while loading, sharp once decoded */
	.media[style*='background-image'] {
		background-size: cover;
		background-position: center;
	}
	img[data-fade] {
		transition: filter 0.35s ease;
	}
	img[data-fade].is-loading {
		filter: blur(16px);
		clip-path: inset(0);
	}
</style>
