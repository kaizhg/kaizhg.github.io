---
import { Image } from 'astro:assets';
import { workImage, type MediaBlock } from '../data/case-studies';

interface Props {
	block: MediaBlock;
	alt?: string;
	sizes?: string;
	eager?: boolean;
	portrait?: boolean;
}

const { block, alt = '', sizes = '(max-width: 1400px) 100vw, 1400px', eager = false, portrait = false } = Astro.props;
---

{
	block.type === 'image' && (
		<Image
			src={workImage(block.src)}
			alt={alt}
			widths={[...new Set([640, 1024, 1600, 2400, block.width].filter((w) => w <= block.width))]}
			sizes={sizes}
			loading={eager ? 'eager' : 'lazy'}
			class:list={['media', { alpha: /\.png$/i.test(block.src), portrait }]}
		/>
	)
}
{
	block.type === 'loop' && (
		<video
			class="media"
			src={block.src}
			width={block.width}
			height={block.height}
			autoplay
			muted
			loop
			playsinline
			preload="metadata"
		/>
	)
}
{
	block.type === 'video' && (
		<video
			class="media"
			src={block.src}
			poster={block.poster}
			width={block.width}
			height={block.height}
			controls
			playsinline
			preload="none"
		/>
	)
}

<style>
	/* Never taller than a screen: shrink to fit and keep the left edge */
	.media {
		display: block;
		width: auto;
		max-width: 100%;
		height: auto;
		max-height: 82vh;
		background: var(--line); /* placeholder tint while a photo loads */
	}
	/* Cut-outs (PNG with transparency) sit straight on the page, no tint behind them */
	.media.alpha {
		background: transparent;
	}
</style>
