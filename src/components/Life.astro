---
/**
 * Conway's Game of Life as the homepage opener. The first generation spells the name;
 * after a beat it evolves. Moving the cursor across the grid seeds cells, a click brings
 * the name back. Pauses off-screen and respects reduced motion (static name only).
 */
interface Props {
	text?: string;
	/** Words that take the name's place on each reset, in a shuffled cycle. */
	words?: string[];
}
const {
	text = 'KAI ZHANG',
	words = ['WHIM', 'EXPLORE', 'INTRIGUE', 'BIZARRE', 'ANALOG', 'SKETCH', 'WONDER', 'GENERATE', 'CURIOUS', 'PLAY', 'SHEN ZHEN', 'ENTP'],
} = Astro.props;
---

<div class="life" data-text={text} data-words={JSON.stringify(words)}>
	<canvas aria-label={`Conway's Game of Life spelling ${text}`} role="img"></canvas>
	<p class="life-hint" aria-hidden="true">
		<span class="life-hint-action">Draw with the cursor · click for the next word</span>
	</p>
</div>

<script>
	type Cleanup = () => void;
	let cleanup: Cleanup | null = null;

	function start(root: HTMLElement): Cleanup {
		const canvas = root.querySelector('canvas')!;
		const ctx = canvas.getContext('2d', { alpha: false })!;
		const name = root.dataset.text ?? 'KAI ZHANG';
		const words: string[] = JSON.parse(root.dataset.words ?? '[]');
		// Reset cycles: name, then the words in a fresh shuffle, then the name again…
		let queue: string[] = [];
		let text = name;
		const nextWord = () => {
			if (queue.length === 0) queue = [...words].sort(() => Math.random() - 0.5).concat(name);
			text = queue.shift()!;
		};
		const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

		let cols = 0, rows = 0, cell = 12, dpr = 1;
		let cells = new Uint8Array(0), next = new Uint8Array(0);
		let seed = new Uint8Array(0); // the name, kept as a fading ghost
		let wake = new Float32Array(0); // per-cell moment (0..1) at which the rules take over
		let fg = '#111', bg = '#f4f4f2', empty = '#e9e9e6';
		let raf = 0, last = 0, holdUntil = 0, running = true;
		const STEP = 150; // ms per generation
		const HOLD = 1200; // ms the word stays untouched
		const DISSOLVE = 3500; // ms over which cells wake up, patch by patch
		const GHOST = 4200; // ms until the ghost of the word is gone
		const CYCLE = 6000; // ms from one word to the next (when nobody is playing)
		let MORPH = 400; // ms: the next word strikes on like a neon tube (re-rolled 300–500 each time)
		const FLICKER = 30; // ms between flicker frames
		let flickerAt = 0;
		let mask = new Uint8Array(0); // which cells are lit this flicker frame
		// Neon ignition: a stuttering blink envelope (fractions of MORPH), then steady on
		const BLINKS = [[0, 0.08, 1], [0.08, 0.18, 0], [0.18, 0.37, 1], [0.37, 0.43, 0], [0.43, 1, 1]] as const;
		const blink = (f: number) => (BLINKS.find(([a, b]) => f >= a && f < b)?.[2] ?? 1) === 1;
		const progress = (t: number) => Math.min(1, Math.max(0, (t - holdUntil) / DISSOLVE));
		const ghostAlpha = (t: number) => 0.16 * Math.max(0, 1 - (t - holdUntil) / GHOST);
		let cycleAt = 0; // when the next word is due
		let morphFrom: Uint8Array | null = null, morphStart = 0; // cross-fade state
		let hovering = false;

		// Clumpy noise: random values blurred a few times so neighbouring cells wake together
		const makeWake = () => {
			wake = new Float32Array(cols * rows);
			for (let i = 0; i < wake.length; i++) wake[i] = Math.random();
			const tmp = new Float32Array(wake.length);
			for (let pass = 0; pass < 4; pass++) {
				for (let y = 0; y < rows; y++) {
					for (let x = 0; x < cols; x++) {
						let sum = 0;
						for (let dy = -1; dy <= 1; dy++)
							for (let dx = -1; dx <= 1; dx++) sum += wake[((y + dy + rows) % rows) * cols + ((x + dx + cols) % cols)];
						tmp[y * cols + x] = sum / 9;
					}
				}
				wake.set(tmp);
			}
			// stretch back to the full 0..1 range after blurring
			let lo = 1, hi = 0;
			for (const v of wake) { if (v < lo) lo = v; if (v > hi) hi = v; }
			for (let i = 0; i < wake.length; i++) wake[i] = (wake[i] - lo) / (hi - lo || 1);
		};

		const colors = () => {
			const cs = getComputedStyle(document.documentElement);
			fg = cs.getPropertyValue('--fg').trim() || fg;
			bg = cs.getPropertyValue('--bg').trim() || bg;
			empty = cs.getPropertyValue('--cell').trim() || empty;
		};

		// A 5x7 bitmap alphabet drawn for the grid: one-cell strokes, scaled by whole cells
		const GLYPHS: Record<string, string[]> = {
			A: ['01110', '10001', '10001', '11111', '10001', '10001', '10001'],
			B: ['11110', '10001', '10001', '11110', '10001', '10001', '11110'],
			C: ['01110', '10001', '10000', '10000', '10000', '10001', '01110'],
			D: ['11110', '10001', '10001', '10001', '10001', '10001', '11110'],
			E: ['11111', '10000', '10000', '11110', '10000', '10000', '11111'],
			F: ['11111', '10000', '10000', '11110', '10000', '10000', '10000'],
			G: ['01110', '10001', '10000', '10111', '10001', '10001', '01111'],
			H: ['10001', '10001', '10001', '11111', '10001', '10001', '10001'],
			I: ['11111', '00100', '00100', '00100', '00100', '00100', '11111'],
			J: ['00111', '00010', '00010', '00010', '00010', '10010', '01100'],
			K: ['10001', '10010', '10100', '11000', '10100', '10010', '10001'],
			L: ['10000', '10000', '10000', '10000', '10000', '10000', '11111'],
			M: ['10001', '11011', '10101', '10101', '10001', '10001', '10001'],
			N: ['10001', '10001', '11001', '10101', '10011', '10001', '10001'],
			O: ['01110', '10001', '10001', '10001', '10001', '10001', '01110'],
			P: ['11110', '10001', '10001', '11110', '10000', '10000', '10000'],
			Q: ['01110', '10001', '10001', '10001', '10101', '10010', '01101'],
			R: ['11110', '10001', '10001', '11110', '10100', '10010', '10001'],
			S: ['01111', '10000', '10000', '01110', '00001', '00001', '11110'],
			T: ['11111', '00100', '00100', '00100', '00100', '00100', '00100'],
			U: ['10001', '10001', '10001', '10001', '10001', '10001', '01110'],
			V: ['10001', '10001', '10001', '10001', '10001', '01010', '00100'],
			W: ['10001', '10001', '10001', '10101', '10101', '10101', '01010'],
			X: ['10001', '10001', '01010', '00100', '01010', '10001', '10001'],
			Y: ['10001', '10001', '01010', '00100', '00100', '00100', '00100'],
			Z: ['11111', '00001', '00010', '00100', '01000', '10000', '11111'],
			'-': ['00000', '00000', '00000', '01110', '00000', '00000', '00000'],
			' ': ['000', '000', '000', '000', '000', '000', '000'],
		};
		const GAP = 1, LETTER_H = 7; // font units; GAP = tracking between letters
		const glyphs = (t: string) => t.toUpperCase().split('').map((c) => GLYPHS[c] ?? GLYPHS[' ']);
		const width = (gs: string[][]) => gs.reduce((w, g) => w + g[0].length, 0) + GAP * (gs.length - 1);
		// One scale for every word, set by the longest, so the type never changes size between words
		const longest = Math.max(...[name, ...words].map((w) => width(glyphs(w))));
		const rasterise = async (into: Uint8Array) => {
			into.fill(0);
			const chars = glyphs(text);
			const units = width(chars);
			// largest whole-cell scale that fits ~70% of the height and ~92% of the width
			const scale = Math.max(1, Math.floor(Math.min((rows * 0.7) / LETTER_H, (cols * 0.92) / longest)));
			let x0 = Math.floor((cols - units * scale) / 2);
			const y0 = Math.floor((rows - LETTER_H * scale) / 2);
			for (const g of chars) {
				for (let gy = 0; gy < LETTER_H; gy++)
					for (let gx = 0; gx < g[gy].length; gx++)
						if (g[gy][gx] === '1')
							for (let sy = 0; sy < scale; sy++)
								for (let sx = 0; sx < scale; sx++) {
									const x = x0 + gx * scale + sx, y = y0 + gy * scale + sy;
									if (x >= 0 && x < cols && y >= 0 && y < rows) into[y * cols + x] = 1;
								}
				x0 += (g[0].length + GAP) * scale;
			}
		};
		// Hard cut to a word (first paint, resize)
		const seedText = async () => {
			await rasterise(cells);
			seed = cells.slice();
			makeWake();
			const now = performance.now();
			holdUntil = now + HOLD;
			cycleAt = now + CYCLE;
			morphFrom = null;
			draw(now);
		};
		// Gentle cut: the live cells fade out while the next word fades in
		const morphTo = async () => {
			const target = new Uint8Array(cols * rows);
			await rasterise(target);
			morphFrom = cells.slice();
			cells = target;
			seed = target.slice();
			makeWake();
			mask = new Uint8Array(cols * rows);
			MORPH = 300 + Math.random() * 200;
			const now = performance.now();
			morphStart = now;
			flickerAt = 0;
			holdUntil = now + MORPH + HOLD;
			cycleAt = now + MORPH + CYCLE;
		};

		const resize = () => {
			const rect = root.getBoundingClientRect();
			dpr = Math.min(devicePixelRatio || 1, 2);
			// ~120 columns on desktop; on phones go finer so the letters stay legible
			cell = rect.width < 640 ? Math.max(5, Math.round(rect.width / 70)) : Math.max(8, Math.min(14, Math.round(rect.width / 120)));
			cols = Math.floor(rect.width / cell);
			rows = Math.floor(rect.height / cell);
			if (cols < 2 || rows < 2) return; // hidden or collapsed: nothing to draw yet
			canvas.width = Math.round(rect.width * dpr);
			canvas.height = Math.round(rect.height * dpr);
			cells = new Uint8Array(cols * rows);
			next = new Uint8Array(cols * rows);
			colors();
			seedText();
		};

		const step = (p: number) => {
			for (let y = 0; y < rows; y++) {
				const yu = ((y - 1 + rows) % rows) * cols, y0 = y * cols, yd = ((y + 1) % rows) * cols;
				for (let x = 0; x < cols; x++) {
					const xl = (x - 1 + cols) % cols, xr = (x + 1) % cols;
					const n =
						cells[yu + xl] + cells[yu + x] + cells[yu + xr] +
						cells[y0 + xl] + cells[y0 + xr] +
						cells[yd + xl] + cells[yd + x] + cells[yd + xr];
					const a = cells[y0 + x];
					// cells still asleep keep their state; awake ones follow Conway's rules
					next[y0 + x] = wake[y0 + x] > p ? a : n === 3 || (a === 1 && n === 2) ? 1 : 0;
				}
			}
			[cells, next] = [next, cells];
		};

		const draw = (t: number) => {
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.fillStyle = bg;
			ctx.fillRect(0, 0, canvas.width / dpr, canvas.height / dpr);
			const s = cell - 1; // 1px gap between cells
			const ox = (canvas.width / dpr - cols * cell) / 2;
			// empty cells: a faint tint so the grid reads against the page
			ctx.fillStyle = empty;
			for (let y = 0; y < rows; y++) for (let x = 0; x < cols; x++) ctx.fillRect(ox + x * cell, y * cell, s, s);
			// ghost of the name under the live cells, fading away
			const ga = t ? ghostAlpha(t) : 0;
			if (ga > 0.005) {
				ctx.globalAlpha = ga;
				ctx.fillStyle = fg;
				for (let y = 0; y < rows; y++)
					for (let x = 0; x < cols; x++)
						if (seed[y * cols + x] && !cells[y * cols + x]) ctx.fillRect(ox + x * cell, y * cell, s, s);
				ctx.globalAlpha = 1;
			}
			ctx.fillStyle = fg;
			if (morphFrom) {
				const ms = t - morphStart;
				if (ms >= MORPH) {
					morphFrom = null;
				} else {
					// refresh the random mask every FLICKER ms
					if (t - flickerAt >= FLICKER) {
						flickerAt = t;
						const ramp = Math.pow(ms / MORPH, 1.4); // how settled the new word is
						const on = blink(ms / MORPH);
						const pLit = on ? 0.35 + 0.65 * ramp : 0.12 * ramp; // word cells lit this frame
						// the old generation flickers out over the first half, never the empty field
						const pOld = Math.max(0, 1 - ms / (MORPH * 0.55)) * (on ? 1 : 0.3);
						for (let i = 0; i < mask.length; i++) {
							if (cells[i]) mask[i] = Math.random() < pLit ? 1 : 0;
							else if (morphFrom[i]) mask[i] = Math.random() < pOld ? 1 : 0;
							else mask[i] = 0;
						}
					}
					for (let y = 0; y < rows; y++)
						for (let x = 0; x < cols; x++) if (mask[y * cols + x]) ctx.fillRect(ox + x * cell, y * cell, s, s);
					return;
				}
			}
			for (let y = 0; y < rows; y++) {
				for (let x = 0; x < cols; x++) {
					if (cells[y * cols + x]) ctx.fillRect(ox + x * cell, y * cell, s, s);
				}
			}
		};

		const loop = (t: number) => {
			raf = requestAnimationFrame(loop);
			if (!running || reduced) return;
			if (morphFrom) {
				draw(t);
				return;
			}
			if (!hovering && t >= cycleAt) {
				cycleAt = Infinity;
				nextWord();
				morphTo();
				return;
			}
			if (t < holdUntil) return;
			const p = progress(t);
			if (t - last < STEP) return;
			last = t;
			step(p);
			draw(t);
		};

		// Cursor paints life; a click restores the name
		let lastX = -1, lastY = -1;
		const paint = (e: PointerEvent) => {
			const rect = canvas.getBoundingClientRect();
			const ox = (rect.width - cols * cell) / 2;
			const x = Math.floor((e.clientX - rect.left - ox) / cell);
			const y = Math.floor((e.clientY - rect.top) / cell);
			if (x === lastX && y === lastY) return;
			lastX = x;
			lastY = y;
			for (let dy = -1; dy <= 1; dy++) {
				for (let dx = -1; dx <= 1; dx++) {
					const cx = (x + dx + cols) % cols, cy = (y + dy + rows) % rows;
					if (Math.random() < 0.7) cells[cy * cols + cx] = 1;
					wake[cy * cols + cx] = 0; // touched cells wake at once
				}
			}
			if (performance.now() < holdUntil) holdUntil = performance.now();
			cycleAt = performance.now() + CYCLE;
			draw(performance.now());
		};
		const enter = () => (hovering = true);
		const leave = () => {
			hovering = false;
			cycleAt = Math.max(cycleAt, performance.now() + CYCLE / 2);
		};
		// A drag paints; only a clean click (no movement) resets to the next word
		let downX = 0, downY = 0;
		const down = (e: PointerEvent) => {
			downX = e.clientX;
			downY = e.clientY;
		};
		const reset = (e: MouseEvent) => {
			if (Math.hypot(e.clientX - downX, e.clientY - downY) > 4 || morphFrom) return;
			nextWord();
			morphTo();
		};

		const io = new IntersectionObserver(([e]) => (running = e.isIntersecting), { threshold: 0.05 });
		io.observe(root);
		const onVis = () => (running = !document.hidden);
		const mq = matchMedia('(prefers-color-scheme: dark)');
		const onTheme = () => {
			colors();
			draw(performance.now());
		};

		resize();
		const ro = new ResizeObserver(() => resize());
		ro.observe(root);
		canvas.addEventListener('pointermove', paint);
		canvas.addEventListener('pointerdown', down);
		canvas.addEventListener('click', reset);
		canvas.addEventListener('pointerenter', enter);
		canvas.addEventListener('pointerleave', leave);
		document.addEventListener('visibilitychange', onVis);
		mq.addEventListener('change', onTheme);
		raf = requestAnimationFrame(loop);

		return () => {
			cancelAnimationFrame(raf);
			ro.disconnect();
			io.disconnect();
			canvas.removeEventListener('pointermove', paint);
			canvas.removeEventListener('pointerdown', down);
			canvas.removeEventListener('click', reset);
			canvas.removeEventListener('pointerenter', enter);
			canvas.removeEventListener('pointerleave', leave);
			document.removeEventListener('visibilitychange', onVis);
			mq.removeEventListener('change', onTheme);
		};
	}

	document.addEventListener('astro:page-load', () => {
		cleanup?.();
		cleanup = null;
		const root = document.querySelector<HTMLElement>('.life');
		if (root) cleanup = start(root);
	});
	document.addEventListener('astro:before-swap', () => {
		cleanup?.();
		cleanup = null;
	});
</script>

<style>
	.life {
		position: relative;
		/* a low, full-width band whose proportion stays put as the page scales */
		width: 100%;
		aspect-ratio: 6 / 1;
		min-height: 160px;
		max-height: 300px;
		cursor: crosshair;
		user-select: none;
		-webkit-user-select: none;
	}
	canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	.life-hint {
		position: absolute;
		right: 0;
		bottom: -22px;
		margin: 0;
		font: 9px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--muted);
		opacity: 0.7;
		pointer-events: none;
	}
	@media (hover: none) {
		.life-hint-action {
			display: none;
		}
		.life {
			cursor: default;
		}
	}
	@media (max-width: 640px) {
		.life {
			aspect-ratio: 3 / 1;
			min-height: 120px;
		}
	}
</style>
