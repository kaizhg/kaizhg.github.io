---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import { ClientRouter } from 'astro:transitions';
import { archive } from '../data/projects';

interface Props {
	title?: string;
	description?: string;
	/** Absolute or site-relative URL of the share image; defaults to the site card. */
	image?: string;
}

const {
	title,
	description = 'Kai Zhang — computational & industrial designer. RISD ID, Harvard GSD. Based in Seattle.',
	image = '/og.png',
} = Astro.props;
const fullTitle = title ? `${title} — Kai Zhang` : 'Kai Zhang';
const path = Astro.url.pathname;
const site = Astro.site ?? new URL('https://kaizhg.github.io');
const canonical = new URL(path, site).href;
const ogImage = new URL(image, site).href;
const archiveSlugs = new Set(archive.map((p) => p.slug));
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
		<link rel="canonical" href={canonical} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Kai Zhang" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<link rel="preload" href="/fonts/NeueMontreal-Semibold.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/NeueMontrealText-Book.woff2" as="font" type="font/woff2" crossorigin />
		<ClientRouter />
		<script is:inline data-astro-rerun>document.documentElement.classList.add('js');</script>
		<script is:inline data-astro-rerun>
			// Edit mode (npm run edit): show problems found in project.md at the top of the page
			if (location.port === '4321') {
				const slug = (location.pathname.match(/^\/work\/([^/]+)/) || [])[1];
				fetch('/edit-errors.json?' + Date.now()).then((r) => (r.ok ? r.json() : {})).then((n) => {
					const hit = n[slug] || n['*'];
					document.getElementById('edit-note')?.remove();
					if (!hit) return;
					const el = document.createElement('div');
					el.id = 'edit-note';
					el.style.cssText = 'position:fixed;left:0;right:0;top:0;z-index:99;padding:10px 24px;font:13px/1.5 ui-monospace,Menlo,monospace;white-space:pre-wrap;background:' + (hit.error ? '#ff4a0f' : '#f2d94e') + ';color:' + (hit.error ? '#fff' : '#111');
					el.textContent = hit.error ? 'project.md 有问题，页面还是上一次的版本：\n' + hit.error : hit.warnings.join('\n');
					document.body.prepend(el);
				}).catch(() => {});
			}
		</script>
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="wordmark">Kai Zhang</a>
			<nav>
				<a href="/" aria-current={path === '/' || (path.startsWith('/work') && !archiveSlugs.has(path.split('/')[2])) ? 'page' : undefined}>Work</a>
				<a href="/archive/" aria-current={path.startsWith('/archive') || (path.startsWith('/work') && archiveSlugs.has(path.split('/')[2])) ? 'page' : undefined}>Archive</a>
				<a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
				<span class="icons">
					<a href="https://www.linkedin.com/in/kai-zhang-653411223/" aria-label="LinkedIn" title="LinkedIn">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
					</a>
					<a href="https://www.instagram.com/zalvink_/" aria-label="Instagram" title="Instagram">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.9 5.9 0 0 0-2.13 1.38A5.9 5.9 0 0 0 .63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13a5.9 5.9 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.9 5.9 0 0 0 2.13-1.38 5.9 5.9 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.9 5.9 0 0 0-1.38-2.13A5.9 5.9 0 0 0 19.86.63C19.1.33 18.22.13 16.95.07 15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
					</a>
					<a href="mailto:this.kaizhang@gmail.com" aria-label="Email" title="Email">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M2 4h20a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1zm1 3.2V18h18V7.2l-9 6.3-9-6.3zM3.6 6l8.4 5.9L20.4 6H3.6z"/></svg>
					</a>
				</span>
			</nav>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<div class="foot-top">
				<p class="foot-cta">
					<a href="mailto:this.kaizhang@gmail.com" class="foot-mail">this.kaizhang@gmail.com ↗</a>
				</p>
				<nav class="foot-links" aria-label="Elsewhere">
					<a href="https://www.linkedin.com/in/kai-zhang-653411223/">LinkedIn</a>
					<a href="https://www.instagram.com/zalvink_/">Instagram</a>
					<a href="https://github.com/kaizhg">GitHub</a>
				</nav>
			</div>
			<div class="foot-bottom">
				<span>© {new Date().getFullYear()} Kai Zhang</span>
				<span>Seattle, WA</span>
			</div>
		</footer>
		<script>
			// Scroll reveal: media and tiles fade up as they enter the viewport (once).
			// Re-run after every client-side navigation so new pages get it too.
			function reveal() {
				const els = document.querySelectorAll<HTMLElement>('.reveal:not(.in)');
				if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) {
					els.forEach((e) => e.classList.add('in'));
					return;
				}
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('in');
								io.unobserve(e.target);
							}
						}
					},
					{ rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
				);
				els.forEach((e) => io.observe(e));
			}
			document.addEventListener('astro:page-load', reveal);
			// Pictures with a blurred stand-in stay blurred until their file has decoded
			document.addEventListener('astro:page-load', () => {
				document.querySelectorAll<HTMLImageElement>('img[data-fade]').forEach((img) => {
					if (img.complete && img.naturalWidth) return;
					img.classList.add('is-loading');
					const done = () => img.classList.remove('is-loading');
					img.addEventListener('load', done, { once: true });
					img.addEventListener('error', done, { once: true });
				});
			});
		</script>
		<div id="lightbox" hidden>
			<img alt="" />
		</div>
		<script>
			// Lightbox: any picture in a case study opens full size; click, Esc or ← → to move on
			document.addEventListener('astro:page-load', () => {
				const box = document.getElementById('lightbox') as HTMLElement | null;
				if (!box) return;
				const big = box.querySelector('img') as HTMLImageElement;
				const pics = Array.from(document.querySelectorAll<HTMLImageElement>('article img.media')).filter(
					(img) => !img.closest('a') && !img.closest('.carousel'),
				);
				let at = -1;
				const largest = (img: HTMLImageElement) => {
					const cands = (img.srcset || '')
						.split(',')
						.map((c) => c.trim().split(/\s+/))
						.filter((c) => c[0])
						.map((c) => ({ src: c[0], w: parseInt(c[1] || '0', 10) }))
						.sort((a, b) => b.w - a.w);
					return cands[0]?.src || img.currentSrc || img.src;
				};
				const show = (i: number) => {
					at = (i + pics.length) % pics.length;
					big.src = largest(pics[at]);
					big.alt = pics[at].alt;
					box.hidden = false;
					document.body.style.overflow = 'hidden';
				};
				const hide = () => {
					box.hidden = true;
					big.removeAttribute('src');
					document.body.style.overflow = '';
				};
				pics.forEach((img, i) => {
					img.classList.add('zoomable');
					img.addEventListener('click', () => show(i));
				});
				box.onclick = hide;
				document.addEventListener('keydown', (e) => {
					if (box.hidden) return;
					if (e.key === 'Escape') hide();
					else if (e.key === 'ArrowRight') show(at + 1);
					else if (e.key === 'ArrowLeft') show(at - 1);
				});
			});
		</script>
	</body>
</html>

<style is:global>
	/* Neue Montreal (PP, free-for-personal-use build) — converted by scripts/add-fonts.py */
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Light.woff2') format('woff2');
		font-weight: 300;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Regular.woff2') format('woff2');
		font-weight: 400 500;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Italic.woff2') format('woff2');
		font-weight: 400 500;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Semibold.woff2') format('woff2');
		font-weight: 600 700;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Extrabold.woff2') format('woff2');
		font-weight: 800 900;
		font-display: swap;
	}
	/* Text cut for running copy */
	@font-face {
		font-family: 'Neue Montreal Text';
		src: url('/fonts/NeueMontrealText-Book.woff2') format('woff2');
		font-weight: 400;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal Text';
		src: url('/fonts/NeueMontrealText-BookItalic.woff2') format('woff2');
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}
	:root {
		--bg: #f4f4f2;
		--fg: #111;
		--muted: #777;
		--line: #d6d6d2;
		--accent: #ff4a0f; /* international orange: the engineer's signal colour */
		--cell: #e8e8e5; /* empty cells of the Game of Life grid */
		--mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
		--sans: 'Neue Montreal', 'PP Neue Montreal', 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif;
		--text: 'Neue Montreal Text', 'Neue Montreal', 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif;
		--gutter: clamp(16px, 4vw, 48px);
		--max: 1520px; /* content stops growing here; 1424px of columns inside the gutters */
		color-scheme: light;
	}
	* {
		box-sizing: border-box;
	}
	html {
		background: var(--bg);
		color: var(--fg);
		font-family: var(--sans);
		font-optical-sizing: auto;
		font-size: 15px;
		-webkit-font-smoothing: antialiased;
	}
	body {
		margin: 0 auto;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		padding-inline: var(--gutter);
		/* The page is tuned for 1440: wider screens get margins, not wider pictures */
		max-width: var(--max);
		box-sizing: border-box;
	}
	main {
		flex: 1;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	img {
		max-width: 100%;
		display: block;
	}
	::selection {
		background: var(--fg);
		color: var(--bg);
	}
	a:focus-visible,
	button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
	}

	/* Scroll reveal (only once scripting is confirmed, so content never stays hidden) */
	html.js .reveal {
		opacity: 0;
		transform: translateY(10px);
		transition: opacity 0.45s ease-out, transform 0.45s ease-out;
	}
	html.js .reveal.in {
		opacity: 1;
		transform: none;
	}
	@media (prefers-reduced-motion: reduce) {
		html.js .reveal {
			opacity: 1;
			transform: none;
			transition: none;
		}
	}
	/* Entrance: page intros rise gently on arrival */
	html.js .intro > * {
		animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
	}
	html.js .intro > :nth-child(2) {
		animation-delay: 0.12s;
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		html.js .intro > * {
			animation: none;
		}
	}
	/* Page transitions: a short cross-fade */
	::view-transition-old(root),
	::view-transition-new(root) {
		animation-duration: 0.35s;
		animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	#lightbox {
		position: fixed;
		inset: 0;
		z-index: 50;
		display: grid;
		place-items: center;
		padding: 4vmin;
		background: rgb(0 0 0 / 0.88);
		cursor: zoom-out;
		animation: lb-in 0.18s ease;
	}
	#lightbox[hidden] {
		display: none;
	}
	#lightbox img {
		max-width: 92vw;
		max-height: 92vh;
		width: auto;
		height: auto;
		object-fit: contain;
		box-shadow: 0 20px 80px rgb(0 0 0 / 0.5);
	}
	:global(.zoomable) {
		cursor: zoom-in;
	}
	@keyframes lb-in {
		from { opacity: 0; }
	}
	.site-footer {
		margin-top: clamp(96px, 14vw, 180px);
		padding-block: 40px 28px;
		border-top: 1px solid var(--line);
	}
	.foot-top {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		gap: 32px;
		flex-wrap: wrap;
		margin-bottom: 56px;
	}
	.foot-cta {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.foot-label {
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.foot-mail {
		font-size: clamp(22px, 2.6vw, 36px);
		font-weight: 600;
		letter-spacing: -0.02em;
		line-height: 1.1;
		transition: color 0.2s ease;
	}
	.foot-mail:hover {
		color: var(--accent);
	}
	.foot-links {
		display: flex;
		gap: 24px;
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	.foot-links a,
	.foot-bottom {
		color: var(--muted);
	}
	.foot-links a:hover {
		color: var(--fg);
	}
	.foot-bottom {
		display: flex;
		justify-content: space-between;
		font: 12px var(--mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
	}
	/* Header: wordmark left; links and icons as one evenly spaced group on the right */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		background: var(--bg);
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 24px;
		padding-block: clamp(22px, 2.8vw, 34px);
		font-size: 12px;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}
	.site-header nav {
		display: flex;
		align-items: center;
		gap: clamp(32px, 5.5vw, 88px);
	}
	.site-header a {
		color: var(--muted);
		font-weight: 500;
		transition: color 0.2s ease;
	}
	.site-header a:hover,
	.site-header a[aria-current='page'],
	.site-header .wordmark {
		color: var(--fg);
	}
	.site-header .wordmark {
		font-weight: 600;
		letter-spacing: 0.08em;
	}
	.site-header .icons {
		display: flex;
		align-items: center;
		gap: clamp(14px, 1.8vw, 22px);
		margin-left: clamp(8px, 2vw, 32px);
	}
	.site-header .icons svg {
		display: block;
		width: 14px;
		height: 14px;
	}
	@media (max-width: 720px) {
		.site-header {
			font-size: 12px;
		}
		.site-header nav {
			gap: 18px;
		}
	}
	.site-header .wordmark {
		white-space: nowrap;
	}
	@media (max-width: 560px) {
		.site-header .icons {
			display: none;
		}
	}
</style>
