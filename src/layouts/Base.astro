---
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title,
	description = 'Kai Zhang — computational & industrial designer. RISD ID, Harvard GSD. Based in Seattle.',
} = Astro.props;
const fullTitle = title ? `${title} — Kai Zhang` : 'Kai Zhang';
const path = Astro.url.pathname;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="32x32" />
		<link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{fullTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<a href="/" class="wordmark">Kai Zhang</a>
			<a href="/" aria-current={path === '/' || path.startsWith('/list') || path.startsWith('/work') ? 'page' : undefined}>Work</a>
			<a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
			<a href="mailto:this.kaizhang@gmail.com" class="last">Contact</a>
		</header>
		<main>
			<slot />
		</main>
		<footer class="site-footer">
			<span>© {new Date().getFullYear()} Kai Zhang</span>
			<span class="links">
				<a href="https://www.linkedin.com/in/kai-zhang-653411223/">LinkedIn</a>
				<a href="https://www.instagram.com/zalvink_/">Instagram</a>
				<a href="https://github.com/kaizhg">GitHub</a>
			</span>
		</footer>
	</body>
</html>

<style is:global>
	/* Neue Montreal (PP, free-for-personal-use build) — converted by scripts/add-fonts.py */
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Light.woff2') format('woff2');
		font-weight: 300;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Regular.woff2') format('woff2');
		font-weight: 400 500;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Italic.woff2') format('woff2');
		font-weight: 400 500;
		font-style: italic;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Semibold.woff2') format('woff2');
		font-weight: 600 700;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal';
		src: url('/fonts/NeueMontreal-Extrabold.woff2') format('woff2');
		font-weight: 800 900;
		font-display: swap;
	}
	/* Text cut for running copy */
	@font-face {
		font-family: 'Neue Montreal Text';
		src: url('/fonts/NeueMontrealText-Book.woff2') format('woff2');
		font-weight: 400;
		font-display: swap;
	}
	@font-face {
		font-family: 'Neue Montreal Text';
		src: url('/fonts/NeueMontrealText-BookItalic.woff2') format('woff2');
		font-weight: 400;
		font-style: italic;
		font-display: swap;
	}
	:root {
		--bg: #f4f4f2;
		--fg: #111;
		--muted: #777;
		--line: #d6d6d2;
		--accent: #2a4bff;
		--mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
		--sans: 'Neue Montreal', 'PP Neue Montreal', 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif;
		--text: 'Neue Montreal Text', 'Neue Montreal', 'Helvetica Neue', Helvetica, Arial, system-ui, sans-serif;
		--gutter: clamp(16px, 4vw, 48px);
		color-scheme: light;
	}
	@media (prefers-color-scheme: dark) {
		:root {
			--bg: #0e0e0e;
			--fg: #ededea;
			--muted: #8a8a86;
			--line: #2a2a28;
			--accent: #7d93ff;
			color-scheme: dark;
		}
	}
	* {
		box-sizing: border-box;
	}
	html {
		background: var(--bg);
		color: var(--fg);
		font-family: var(--sans);
		font-optical-sizing: auto;
		font-size: 15px;
		-webkit-font-smoothing: antialiased;
	}
	body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		padding-inline: var(--gutter);
	}
	main {
		flex: 1;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	img {
		max-width: 100%;
		display: block;
	}
	.site-footer {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		flex-wrap: wrap;
		font-family: var(--mono);
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}
	/* Header: wordmark and links spread across four equal columns, generous air above and below */
	.site-header {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		align-items: baseline;
		padding-block: clamp(28px, 4vw, 48px) clamp(24px, 3vw, 40px);
		font-size: 13px;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}
	.site-header a {
		color: var(--muted);
		transition: color 0.2s ease;
	}
	.site-header a:hover,
	.site-header a[aria-current='page'],
	.site-header .wordmark {
		color: var(--fg);
	}
	.site-header .wordmark {
		font-weight: 600;
	}
	.site-header .last {
		text-align: right;
	}
	@media (max-width: 720px) {
		.site-header {
			grid-template-columns: auto 1fr 1fr auto;
			gap: 16px;
		}
	}
	.site-footer .links {
		display: flex;
		gap: 1.5rem;
	}
	.site-footer a {
		color: var(--muted);
	}
	.site-footer a:hover {
		color: var(--fg);
	}
	.site-footer {
		padding-block: 40px 24px;
		color: var(--muted);
		border-top: 1px solid var(--line);
		margin-top: 96px;
	}
</style>
